// FAQ - AI Features (added)
"faq.aiFeatures" = "Fonctionnalités IA";
"faq.whatIsBrainIcon" = "À quoi sert le bouton Fit ?";
"faq.whatIsBrainIconAnswer" = "Appuyez sur le bouton Fit doré (en bas à droite) dans le visualiseur pour lancer la segmentation SmartyPants. Par défaut, l'objet le plus fiable est découpé en transparence sur votre pièce 3D. Appuyez sur Terminé (en haut à droite) pour quitter. Pour choisir des pièces précises, affichez d'abord les contrôles et activez le mode full-video.";
"faq.whatIsViewfinderButton" = "What does full-video mode do in the room viewer?";
"faq.whatIsViewfinderButtonAnswer" = "While Fit is active, summon controls and tap the viewfinder icon to toggle full-video mode. You get a live camera feed with detection boxes—tap one or more items, then tap Segment. The camera hides and transparent cutouts composite over your 3D room. Tap Done (top-right) to exit segment mode or leave Fit entirely.";
"faq.howToScreenshot" = "Comment prendre une capture d'écran ?";
"faq.howToScreenshotAnswer" = "Appuyez sur la pièce pour afficher les contrôles, puis sur Capture. Enregistre la vue actuelle (y compris les overlays meubles si Fit est actif) dans Photos.";
"faq.howToSaveRoom" = "Comment enregistrer une pièce ?";
"faq.howToSaveRoomAnswer" = "After generating a 3D room, tap the room to summon controls, then tap the save icon (download arrow) and enter a name. If you leave a preview without saving, that room is discarded.";

// FAQ - 3D Room Controls (added)
"faq.roomControls" = "Contrôles de Pièce 3D";
"faq.howToNavigate" = "Comment naviguer dans la pièce ?";
"faq.howToNavigateAnswer" = "Drag on the room to orbit the camera and pinch to zoom. Tap the screen to summon the toolbar, then use the viewfinder icon to recenter. A quiet summon disk at bottom-left also brings controls back when hidden.";
"faq.whatDoArrowsDo" = "Comment afficher ou masquer les contrôles ?";
"faq.whatDoArrowsDoAnswer" = "Le visualiseur est immersif—les contrôles se masquent pour une vue épurée. Appuyez sur la pièce pour afficher la barre d'outils. Le bouton Fit doré en bas à droite reste toujours visible. Quand Fit est actif, Terminé apparaît en haut à droite pour quitter la segmentation.";
"faq.whatIsMemoryDisplay" = "Que signifie le nombre MB ?";
"faq.whatIsMemoryDisplayAnswer" = "Le MB (mégaoctets) affiché dans les pièces indique la taille du fichier. Cela vous aide à gérer le stockage. Le stockage total utilisé par toutes les pièces est affiché en haut de l'écran d'accueil.";

