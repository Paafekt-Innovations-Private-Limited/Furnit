// FAQ - AI Features (added)
"faq.aiFeatures" = "Funciones de IA";
"faq.whatIsBrainIcon" = "¿Qué hace el botón Fit?";
"faq.whatIsBrainIconAnswer" = "Toca el botón Fit dorado (abajo a la derecha) en el visor para iniciar la segmentación SmartyPants. Por defecto segmenta automáticamente el objeto de mayor confianza como recorte transparente sobre tu habitación 3D. Toca Hecho (arriba a la derecha) para salir. Para elegir piezas concretas, muestra los controles y activa el modo full-video primero.";
"faq.whatIsViewfinderButton" = "What does full-video mode do in the room viewer?";
"faq.whatIsViewfinderButtonAnswer" = "While Fit is active, summon controls and tap the viewfinder icon to toggle full-video mode. You get a live camera feed with detection boxes—tap one or more items, then tap Segment. The camera hides and transparent cutouts composite over your 3D room. Tap Done (top-right) to exit segment mode or leave Fit entirely.";
"faq.howToScreenshot" = "¿Cómo tomo una captura de pantalla?";
"faq.howToScreenshotAnswer" = "Toca la habitación para mostrar controles y luego Capturar. Guarda la vista actual (incluidos overlays de muebles con Fit activo) en Fotos.";
"faq.howToSaveRoom" = "¿Cómo guardo una habitación?";
"faq.howToSaveRoomAnswer" = "After generating a 3D room, tap the room to summon controls, then tap the save icon (download arrow) and enter a name. If you leave a preview without saving, that room is discarded.";

// FAQ - 3D Room Controls (added)
"faq.roomControls" = "Controles de Habitación 3D";
"faq.howToNavigate" = "¿Cómo navego dentro de la habitación?";
"faq.howToNavigateAnswer" = "Drag on the room to orbit the camera and pinch to zoom. Tap the screen to summon the toolbar, then use the viewfinder icon to recenter. A quiet summon disk at bottom-left also brings controls back when hidden.";
"faq.whatDoArrowsDo" = "¿Cómo mostrar u ocultar los controles del visor?";
"faq.whatDoArrowsDoAnswer" = "El visor usa modo inmersivo—los controles se ocultan para una vista limpia. Toca la habitación para mostrar la barra. El botón Fit dorado abajo a la derecha siempre está visible. Con Fit activo, Hecho aparece arriba a la derecha para salir de la segmentación.";
"faq.whatIsMemoryDisplay" = "¿Qué significa el número MB?";
"faq.whatIsMemoryDisplayAnswer" = "El MB (megabytes) mostrado en las habitaciones indica el tamaño del archivo. Esto te ayuda a administrar el almacenamiento. El almacenamiento total usado por todas las habitaciones se muestra en la parte superior de la pantalla de inicio.";

