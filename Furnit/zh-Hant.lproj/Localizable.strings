// FAQ - Room Creation
"faq.roomCreation" = "房間建立";
"faq.howToCreate" = "如何建立3D房間？";
"faq.howToCreateAnswer" = "Tap Photo → 3D on the home screen toolbar (or Create Room from Photo in the empty state), then take or select a photo of your room. You'll see two options for creating your 3D room.";
"faq.howToTakePhoto" = "如何拍照來建立房間？";
"faq.howToTakePhotoAnswer" = "When creating a room, choose Take a Photo. You can pick Standard (1x) or Wide Angle (0.5× ultra-wide). Hold your device steady and tap capture. The photo is then used to build your 3D room.";
"faq.depthAwareRoomPhoto" = "用應用程式內建相機拍照會比較好嗎？";
"faq.depthAwareRoomPhotoAnswer" = "會。在支援的裝置上，建立房間時選拍照而非從相簿挑圖，可使用內建相機搭配深度（若裝置提供），有助於 3D 房間的建立與比例。";
"faq.twoMethods" = "兩種房間建立方式是什麼？";
"faq.twoMethodsAnswer" = "選擇照片後，您可以選擇：1) AI 驅動的 3D 房間 - 使用人工智慧自動建立逼真的 3D 房間，或 2) 手動設定 - 您自己繪製房間邊界以獲得更多控制。";
"faq.whatIsAIRoom" = "什麼是 AI 驅動的 3D 房間？";
"faq.whatIsAIRoomAnswer" = "AI Room uses GeoCalib for camera calibration and Depth Anything for metric depth to build a textured 3D room from your photo. Pick a photo and the app handles the rest; no drawing required.";
"faq.whatIsManualRoom" = "什麼是手動設定？";
"faq.whatIsManualRoomAnswer" = "手動設定時，您在照片上繪製房間牆壁的輪廓。這樣您可以更精確地控制 3D 房間的外觀。當您想自己微調房間形狀時非常有用。";
"faq.whichMethodBetter" = "我該選哪種方式？";
"faq.whichMethodBetterAnswer" = "建議先試 AI 驅動 - 更快，對大多數房間效果很好。如果結果不太理想，用手動設定在您想要的位置繪製牆壁。兩種都可以試試看您更喜歡哪種！";
"faq.bestPhotos" = "什麼樣的照片效果最好？";
"faq.bestPhotosAnswer" = "為獲得最佳效果，請在光線充足的環境下拍攝，並保持相機水平。盡量拍攝整個房間，包括地板、牆壁和天花板邊緣。避免模糊或昏暗的照片。";
"faq.generationFailing" = "為什麼我的房間產生失敗？";
"faq.generationFailingAnswer" = "如果照片太暗、模糊或沒有顯示足夠的房間特徵，房間產生可能會失敗。請嘗試在更好的光線下以更寬的角度拍攝新照片。";
"faq.howManyRooms" = "我可以建立多少個房間？";
"faq.howManyRoomsAnswer" = "你最多可以建立20個房間。刪除舊房間以騰出新空間。主畫面頂部會顯示房間數量與已使用的儲存空間。";

// FAQ - Furniture Segmentation
"faq.furnitureSegmentation" = "傢俱分割";
"faq.whatIsSegmentation" = "什麼是傢俱分割？";
"faq.whatIsSegmentationAnswer" = "Furniture segmentation runs from the room viewer via the Fit button. By default one primary item is auto-segmented. In full-video mode, select detected items first; Segment then creates transparent cutouts only for those pieces.";
"faq.howToSegment" = "如何在房間檢視器中分割家具？";
"faq.howToSegmentAnswer" = "Tap Fit in the room viewer. For a quick check it auto-segments the main item. To pick specific pieces: summon controls, enable full-video mode, point the camera at the furniture, tap detection boxes, then tap Segment. Tap Done (top-right) to exit.";
"faq.notDetected" = "為什麼我的傢俱沒有被偵測到？";
"faq.notDetectedAnswer" = "傢俱偵測在清晰、光線充足且傢俱明顯可見的照片中效果最佳。確保傢俱沒有被部分遮擋或與背景融合。";
"faq.multiplePieces" = "我可以分割多件傢俱嗎？";
"faq.multiplePiecesAnswer" = "Yes! In full-video mode you can tap several detection boxes, then tap Segment once to cut out all selected pieces together over your 3D room. You can also segment items one at a time using the default Fit flow.";

// FAQ - 3D Room & Fitment
"faq.roomFitment" = "如何確認傢俱是否合適？";
"faq.roomFitmentAnswer" = "分割後可在 3D 房間中縮放和移動去背。全影片模式下，分割會將所選物件疊加在房間上，便於同時對比多件家具與空間。";

// FAQ - Placement intelligence & aesthetic
"faq.placementIntelligence" = "擺放智慧與美學";
"faq.whatIsPlacementIntelligence" = "什麼是「擺放智慧」（Placement Intelligence）？";
"faq.whatIsPlacementIntelligenceAnswer" = "While Fit is active in supported 3D room viewers, a Placement Intelligence card shows whether the detected furniture fits within the room dimensions. Tap the header to expand full details, or leave it collapsed to save space.";
"faq.furnitureColorAesthetic" = "美學評分用的顏色怎麼來的？";
"faq.furnitureColorAestheticAnswer" = "App 會對 AI 家具去背（與即時分割疊加層相同）中可見像素做 RGB 平均，再與從地板、牆面、天花板取樣的顏色比較。若去背尚未就緒，會暫用房間調色板的推斷色，直到分割提供真實取樣。";
"faq.whatDoHarmonyContrastMean" = "和諧度、對比、風格契合是什麼意思？";
"faq.whatDoHarmonyContrastMeanAnswer" = "它們只是簡單的設計啟發規則，不是品味評判。和諧度描述家具顏色與房間主色的關係（例如類似色或互補色）。對比衡量與典型地面、牆面亮度的差異。風格契合把從房間推斷的寬泛風格標籤與預設的「現代／極簡」設定相比，故僅供參考。";
"faq.whenDoesAestheticScoreLow" = "什麼情況下美學分數會偏低或顯示「衝突（clash）」？";
"faq.whenDoesAestheticScoreLowAnswer" = "高飽和物件若色相與 App 內的和諧配色規則、以及你房間取樣色不搭，分數往往較低——例如酸綠、洋紅、紫色、安全橘放在偏米色、暖棕調房間，或空間取樣幾乎單色卻仍用刺眼原色。與地板或牆面亮度非常接近（棕上棕、灰上灰）也可能拉低對比，即便你主觀喜歡。若房間被推斷為鄉村風、傳統風，風格契合可能偏低，因為家具設定預設帶現代／極簡標籤。雜亂背景下得到的灰濛濛平均色有時會落在「中性」區間而非衝突。分數僅供提示，實際布置請以肉眼為準。";

"faq.howToView" = "如何檢視我的3D房間？";
"faq.howToViewAnswer" = "在主畫面點按任意房間開啟 3D 檢視器。拖動環視，捏合縮放。點按房間可喚出更多控制項（重新置中、尺規、Capture）。右下角金色 Fit 按鈕始終可見。";
"faq.howToPlace" = "如何在房間中放置傢俱？";
"faq.howToPlaceAnswer" = "點擊分割後，選取的家具會以疊圖形式出現在房間裡。拖曳可定位，雙指縮放可調整大小，旋轉可調整方向。";
"faq.sampleRoom" = "我可以使用範例房間嗎？";
"faq.sampleRoomAnswer" = "可以！應用程式提供範例房間供你體驗。從探索部分存取它們，無需先建立自己的房間即可嘗試傢俱佈置。";
"faq.accuracy" = "3D模型有多準確？";
"faq.accuracyAnswer" = "The 3D room is estimated from one photo using camera calibration and metric depth. Dimensions are useful as guidance, not tape-measure accurate. Furniture sizing is most reliable on phones with AR/depth support.";
"faq.adjustDimensions" = "我可以調整房間尺寸嗎？";
"faq.adjustDimensionsAnswer" = "You cannot edit AI room dimensions manually. After saving, summon controls and tap the ruler to see estimated width, height, and depth. During the pre-save preview, dimension chips are hidden—save the room first, then reopen to see measurements. Manual rooms follow the boundaries you draw.";
"faq.furnitureMeasurements" = "傢俱與測量";
"faq.arAssistedSizing" = "什麼是 AR 輔助傢俱尺寸？";
"faq.arAssistedSizingAnswer" = "Tap Fit to segment furniture first. Use the sizing control in the summoned toolbar when you want room-relative scale. On phones with AR/depth support, the app uses live camera depth; without depth, furniture measurements are approximate.";
"faq.measurementPill" = "畫面上小小的測量資訊是什麼？";
"faq.measurementPillAnswer" = "SmartyPants 開啟時，可能會顯示預估的傢俱高度與房間高度。點一下可輸入實際尺寸以提高準確度。若房間照片以廣角（0.5×）拍攝，請一併標示，畫面構圖才會一致。";
"faq.resetOverlayScale" = "偵測遮罩的縮放看起來不對，怎麼辦？";
"faq.resetOverlayScaleAnswer" = "There is no overflow menu now. If the overlay looks off, tap Done to exit Fit and tap Fit again, or pinch the furniture manually to fine-tune its size.";

