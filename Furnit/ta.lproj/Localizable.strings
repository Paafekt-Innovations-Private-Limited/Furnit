"home.librarySubtitle" = "இந்தச் சாதனத்தில் சேமிக்கப்பட்ட உங்கள் 3D அறைகள்.";
"home.storageTitle" = "இந்தச் சாதனத்தில் சேமிக்கப்பட்டது";
"home.storagePath" = "அறைகள் Paafekt-இன் தனிப்பட்ட பயன்பாட்டுச் சேமிப்பகத்தில் இருக்கும்; தானாகப் பதிவேற்றப்படாது. உள் இருப்பிடம்: Documents/SavedRooms.";
"home.storageWarning" = "Paafekt-ஐ நிறுவல் நீக்கினால் சேமித்த அறைகள் நிரந்தரமாக அழியும். வைத்திருக்க வேண்டியவற்றை முதலில் பகிரவும்.";
"home.noModels" = "இன்னும் அறைகள் இல்லை";
"home.noModelsDescription" = "புகைப்படத்திலிருந்து முதல் 3D அறையை உருவாக்குங்கள் அல்லது Manual Setup மூலம் அமைக்குங்கள். அறைகள் இந்தச் சாதனத்தில் சேமிக்கப்படும்.";
"home.createRoom" = "அறை உருவாக்கு";
"home.createRoomToolbarLabel" = "அறை உருவாக்கு";
"deleteRoom.title" = "இந்த அறையை நீக்கவா?";
"deleteRoom.message" = "இந்த அறை இந்தச் சாதனத்திலிருந்து நிரந்தரமாக நீக்கப்படும். இந்தச் செயலை மீட்டெடுக்க முடியாது.";
"profile.deleteAccount" = "கணக்கை நீக்கு";
"profile.deleteAccountConfirmTitle" = "கணக்கை நீக்கு";
"profile.deleteAccountConfirmMessage" = "உங்கள் கணக்கையும் உள்நுழைவுத் தரவையும் நிரந்தரமாக நீக்கவா? இந்தச் சாதனத்தில் சேமித்த அறைகள் நீங்கள் நீக்கும் வரை அல்லது Paafekt-ஐ நிறுவல் நீக்கும் வரை இருக்கும்.";
"profile.deleteAccountSuccessTitle" = "கணக்கு நீக்கப்பட்டது";
"profile.deleteAccountSuccessMessage" = "உங்கள் கணக்கு நீக்கப்பட்டு நீங்கள் வெளியேற்றப்பட்டுள்ளீர்கள்.";
"settings.legalSummary" = "அறை செயலாக்கமும் மரச்சாமான் பகுப்பாய்வும் சாதனத்திலேயே நடக்கின்றன. நீங்கள் வெளிப்படையாகப் பகிராத வரை அறைகள் தனிப்பட்ட பயன்பாட்டுச் சேமிப்பகத்தில் இருக்கும். Firebase தொலைபேசி-எண் அங்கீகாரம் மற்றும் முறைகேடு-தடுப்புத் தரவைச் செயலாக்குகிறது.";
"faq.roomCreation" = "தொடங்குதல்";
"faq.howToCreate" = "அறையை எப்படி உருவாக்குவது?";
"faq.howToCreateAnswer" = "அறை உருவாக்கு என்பதைத் தட்டி, புகைப்படம் எடுக்கவும் அல்லது தேர்ந்தெடுக்கவும். தானியங்கி மதிப்பீட்டுக்கு AI Room அல்லது அறையை நீங்களே வரையறுக்க Manual Setup தேர்ந்தெடுக்கவும். முடித்த அறையை அறை நூலகத்தில் சேர்க்கச் சேமிக்கவும்.";
"faq.twoMethods" = "AI Room மற்றும் Manual Setup இடையிலான வேறுபாடு என்ன?";
"faq.twoMethodsAnswer" = "AI Room ஒரு புகைப்படத்திலிருந்து அறை அளவுகளை மதிப்பிட்டு, அளவிடப்பட்ட நயமுள்ள பிரதிநிதித்துவத்தை உருவாக்குகிறது. இது முழுமையான கனஅளவு மறுகட்டமைப்பு அல்ல. Manual Setup அறை எல்லைகளை நீங்களே வரையறுக்க உதவுகிறது.";
"faq.whatIsAIRoomAnswer" = "AI Room சாதனத்திலேயே ஆழ மதிப்பீடு, மரச்சாமான் நங்கூரங்கள், கேமரா அளவுத்திருத்தம் ஆகியவற்றைப் பயன்படுத்தி ஒரு புகைப்படத்திலிருந்து அளவிடப்பட்ட நயமுள்ள அறையை மதிப்பிடுகிறது. இது முழுமையான கனஅளவு மறுகட்டமைப்பு அல்ல.";
"faq.whatIsManualRoomAnswer" = "முடிவுப் பிரதிநிதித்துவத்தை அதிகம் கட்டுப்படுத்த, புகைப்படத்திலேயே அறை எல்லைகளை நேரடியாக வரையறுக்க Manual Setup உதவுகிறது.";
"faq.whichMethodBetterAnswer" = "வேகமான தானியங்கி மதிப்பீட்டுக்கு AI Room தேர்ந்தெடுக்கவும். அறை எல்லைகளில் நேரடி கட்டுப்பாடு வேண்டுமெனில் Manual Setup தேர்ந்தெடுக்கவும். ஒரு முடிவு பொருந்தவில்லை என்றால் மற்ற முறையை முயலவும்.";
"faq.howManyRoomsAnswer" = "20 அறைகள் வரை சேமிக்கலாம். இடம் பெற தேவையற்ற அறைகளை நீக்கவும். அறை நூலகம் தற்போதைய அறை எண்ணிக்கையையும் பயன்படுத்திய மொத்த சேமிப்பையும் காட்டுகிறது.";
"faq.whereRoomsSaved" = "என் அறைகள் எங்கே சேமிக்கப்படுகின்றன?";
"faq.whereRoomsSavedAnswer" = "அறைகள் இந்தச் சாதனத்தில் Paafekt-இன் தனிப்பட்ட பயன்பாட்டுச் சேமிப்பகத்தில் இருக்கும்; தானாகப் பதிவேற்றப்படாது. உள் இருப்பிடம்: Documents/SavedRooms.";
"faq.arePhotosUploaded" = "என் அறைப் புகைப்படங்கள் பதிவேற்றப்படுமா?";
"faq.arePhotosUploadedAnswer" = "இல்லை. அறை உருவாக்கம், மரச்சாமான் கண்டறிதல், Placement Intelligence ஆகியவை இந்தச் சாதனத்தில் நடக்கின்றன. Firebase தொலைபேசி-எண் அங்கீகாரம் மற்றும் முறைகேடு-தடுப்புத் தரவை தனியாகச் செயலாக்குகிறது. நீங்கள் வெளிப்படையாகப் பகிரும்போது மட்டுமே உள்ளடக்கம் Paafekt-இலிருந்து வெளியேறும்.";
"faq.aiFeatures" = "மரச்சாமான் கண்டறிதல் மற்றும் அளவிடுதல்";
"faq.whatIsBrainIconAnswer" = "மரச்சாமானைக் கண்டறிந்து 3D அறையின் மேல் வெளிப்படையான வெட்டுருவை உருவாக்க Fit-ஐத் தட்டவும். நகர்த்த இழுக்கவும்; அளவு மாற்ற பிஞ்ச் செய்யவும். Fit ஒரு காட்சி முன்னோட்டம்; அளவியல் வழிகாட்டலுக்கு AR-உதவி அளவிடுதல் தேவை.";
"faq.whatIsSegmentationAnswer" = "கேமரா காட்சியில் மரச்சாமானைக் கண்டறிந்து, அதன் தெரியும் பிக்சல்களைப் பின்னணியிலிருந்து பிரித்து நகர்த்தக்கூடிய வெட்டுருவாகக் காட்டுவதே மரச்சாமான் பிரிப்பு. செயலாக்கம் இந்தச் சாதனத்தில் நடக்கிறது.";
"faq.accuracy" = "அறை மற்றும் மரச்சாமான் அளவீடுகள் எவ்வளவு துல்லியமானவை?";
"faq.accuracyAnswer" = "அளவீடுகள் சாதனத்திலேயே கணிக்கப்படும் மதிப்புகள்; புகைப்படத் தரம், வெளிச்சம், கேமரா கோணம், AR கண்காணிப்பு ஆகியவற்றால் மாறலாம். வழிகாட்டலாக மட்டும் பயன்படுத்தி முக்கிய அளவுகளை முடிவெடுக்கும் முன் நீங்களே உறுதிப்படுத்தவும்.";
"faq.arAssistedSizing" = "AR-உதவி அளவிடுதல் என்றால் என்ன?";
"faq.arAssistedSizingAnswer" = "ஆதரிக்கப்படும் கேமரா மற்றும் ஆழத் திறன்களைப் பயன்படுத்தி மரச்சாமான் அளவுகளை மதிப்பிடுவதே AR-உதவி அளவிடுதல். முடிவுகள் படம்பிடிப்புத் தரம் மற்றும் கண்காணிப்புச் சூழலைப் பொறுத்த கணிப்புகளே.";
"faq.multiplePiecesAnswer" = "முழு-வீடியோ முறையில் பல கண்டறிதல் பெட்டிகளைத் தேர்ந்தெடுத்து Segment-ஐத் தட்டினால் அவற்றின் வெட்டுருக்கள் ஒன்றாக உருவாகும். இயல்புநிலை Fit முறையில் ஒவ்வொன்றாகவும் பிரிக்கலாம்.";
"faq.placementIntelligence" = "Placement Intelligence";
"faq.whatIsPlacementIntelligenceAnswer" = "Placement Intelligence ஒரு பொருளின் மதிப்பிட்ட அகலம், உயரம், கணிக்கப்பட்ட ஆழத்தை அறையின் எல்லையுடன் ஒப்பிடுகிறது. இது அளவியல் பொருத்தத்தை மட்டும் தெரிவிக்கும்; காலியான தரை இடத்தைக் கண்டறியாது.";
"faq.aiRoomManualSetup" = "AI Room & Manual Setup";
