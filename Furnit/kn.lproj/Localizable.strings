"faq.whereRoomsSavedAnswer" = "ಕೊಠಡಿಗಳು ಈ ಸಾಧನದಲ್ಲಿರುವ Paafekt ನ ಖಾಸಗಿ ಆಪ್ ಸಂಗ್ರಹಣೆಯಲ್ಲಿ ಉಳಿಯುತ್ತವೆ ಮತ್ತು ಸ್ವಯಂಚಾಲಿತವಾಗಿ ಅಪ್‌ಲೋಡ್ ಆಗುವುದಿಲ್ಲ. ಆಂತರಿಕ ಸ್ಥಳ: Documents/SavedRooms.";
"faq.arePhotosUploaded" = "ನನ್ನ ಕೊಠಡಿಯ ಫೋಟೋಗಳನ್ನು ಅಪ್‌ಲೋಡ್ ಮಾಡಲಾಗುತ್ತದೆಯೇ?";
"faq.arePhotosUploadedAnswer" = "ಇಲ್ಲ. ಕೊಠಡಿ ರಚನೆ, ಪೀಠೋಪಕರಣ ಪತ್ತೆ ಮತ್ತು Placement Intelligence ಈ ಸಾಧನದಲ್ಲೇ ನಡೆಯುತ್ತವೆ. Firebase ಪ್ರತ್ಯೇಕವಾಗಿ ಫೋನ್-ಸಂಖ್ಯೆ ದೃಢೀಕರಣ ಮತ್ತು ದುರುಪಯೋಗ ತಡೆ ಡೇಟಾವನ್ನು ಸಂಸ್ಕರಿಸುತ್ತದೆ. ನೀವು ಸ್ಪಷ್ಟವಾಗಿ ಹಂಚಿಕೊಂಡಾಗ ಮಾತ್ರ ವಿಷಯ Paafekt ನಿಂದ ಹೊರಹೋಗುತ್ತದೆ.";
"faq.aiFeatures" = "ಪೀಠೋಪಕರಣ ಪತ್ತೆ ಮತ್ತು ಗಾತ್ರ ನಿರ್ಧಾರ";
"faq.whatIsBrainIconAnswer" = "ಪೀಠೋಪಕರಣವನ್ನು ಪತ್ತೆಮಾಡಿ ನಿಮ್ಮ 3D ಕೊಠಡಿಯ ಮೇಲೆ ಪಾರದರ್ಶಕ ಕಟ್‌ಔಟ್ ರಚಿಸಲು Fit ಟ್ಯಾಪ್ ಮಾಡಿ. ಕಟ್‌ಔಟ್‌ನ ಸ್ಥಾನ ಬದಲಿಸಲು ಎಳೆಯಿರಿ ಮತ್ತು ಗಾತ್ರ ಬದಲಿಸಲು ಪಿಂಚ್ ಮಾಡಿ. Fit ದೃಶ್ಯ ಪೂರ್ವವೀಕ್ಷಣೆ ಮಾತ್ರ; ಅಳತೆಯ ಮಾರ್ಗದರ್ಶನಕ್ಕೆ AR-ಸಹಾಯಿತ ಗಾತ್ರ ನಿರ್ಧಾರ ಬೇಕಾಗುತ್ತದೆ.";
"faq.whatIsSegmentationAnswer" = "ಪೀಠೋಪಕರಣ ವಿಭಜನೆ ಕ್ಯಾಮೆರಾ ದೃಶ್ಯದಲ್ಲಿನ ವಸ್ತುವನ್ನು ಪತ್ತೆಮಾಡಿ, ಅದರ ಗೋಚರ ಪಿಕ್ಸೆಲ್‌ಗಳನ್ನು ಹಿನ್ನೆಲೆಯಿಂದ ಬೇರ್ಪಡಿಸುತ್ತದೆ; ಹೀಗಾಗಿ ಅದು ಚಲಿಸಬಹುದಾದ ಕಟ್‌ಔಟ್ ಆಗಿ ಕಾಣುತ್ತದೆ. ಸಂಸ್ಕರಣೆ ಈ ಸಾಧನದಲ್ಲೇ ನಡೆಯುತ್ತದೆ.";
"faq.accuracy" = "ಕೊಠಡಿ ಮತ್ತು ಪೀಠೋಪಕರಣ ಅಳತೆಗಳು ಎಷ್ಟು ನಿಖರ?";
"faq.accuracyAnswer" = "ಅಳತೆಗಳು ಸಾಧನದಲ್ಲೇ ಮಾಡುವ ಅಂದಾಜುಗಳು; ಫೋಟೋದ ಗುಣಮಟ್ಟ, ಬೆಳಕು, ಕ್ಯಾಮೆರಾ ಕೋನ ಮತ್ತು AR ಟ್ರ್ಯಾಕಿಂಗ್‌ಗೆ ಅನುಗುಣವಾಗಿ ಬದಲಾಗಬಹುದು. ಅವುಗಳನ್ನು ಮಾರ್ಗದರ್ಶನವಾಗಿ ಬಳಸಿ ಮತ್ತು ಮುಖ್ಯ ಆಯಾಮಗಳನ್ನು ನಿರ್ಧಾರ ಮಾಡುವ ಮೊದಲು ನೀವೇ ದೃಢಪಡಿಸಿ.";
"faq.arAssistedSizing" = "AR-ಸಹಾಯಿತ ಗಾತ್ರ ನಿರ್ಧಾರ ಎಂದರೇನು?";
"faq.arAssistedSizingAnswer" = "AR-ಸಹಾಯಿತ ಗಾತ್ರ ನಿರ್ಧಾರವು ಬೆಂಬಲಿತ ಕ್ಯಾಮೆರಾ ಮತ್ತು ಆಳ ಸಾಮರ್ಥ್ಯಗಳನ್ನು ಬಳಸಿ ಪೀಠೋಪಕರಣದ ಆಯಾಮಗಳನ್ನು ಅಂದಾಜಿಸುತ್ತದೆ. ಫಲಿತಾಂಶಗಳು ಸೆರೆಹಿಡಿಯುವ ಗುಣಮಟ್ಟ ಮತ್ತು ಟ್ರ್ಯಾಕಿಂಗ್ ಪರಿಸ್ಥಿತಿಗಳ ಮೇಲೆ ಅವಲಂಬಿತವಾಗಿದ್ದು ಅಂದಾಜುಗಳಾಗಿಯೇ ಇರುತ್ತವೆ.";
