"faq.howToCreateAnswer" = "മുറി സൃഷ്ടിക്കുക ടാപ്പ് ചെയ്ത് ഫോട്ടോ എടുക്കുകയോ തിരഞ്ഞെടുക്കുകയോ ചെയ്യുക. സ്വയമേവ കണക്കാക്കാൻ AI Room അല്ലെങ്കിൽ മുറി സ്വയം നിർവചിക്കാൻ Manual Setup തിരഞ്ഞെടുക്കുക. പൂർത്തിയായ മുറി മുറി ലൈബ്രറിയിൽ ചേർക്കാൻ സേവ് ചെയ്യുക.";
"faq.twoMethods" = "AI Room-ഉം Manual Setup-ഉം തമ്മിലുള്ള വ്യത്യാസമെന്ത്?";
"faq.twoMethodsAnswer" = "AI Room ഒരു ഫോട്ടോയിൽ നിന്ന് മുറിയുടെ അളവുകൾ കണക്കാക്കി അളവോടുകൂടിയ ടെക്സ്ചർ പ്രതിനിധാനം സൃഷ്ടിക്കുന്നു. ഇത് പൂർണ്ണ വോള്യൂമെട്രിക് പുനർനിർമ്മാണമല്ല. Manual Setup മുറിയുടെ അതിരുകൾ സ്വയം നിർവചിക്കാൻ അനുവദിക്കുന്നു.";
"faq.whatIsAIRoomAnswer" = "AI Room ഉപകരണത്തിലെ ഡെപ്ത് എസ്റ്റിമേഷൻ, ഫർണിച്ചർ ആങ്കറുകൾ, ക്യാമറ കാലിബ്രേഷൻ എന്നിവ ഉപയോഗിച്ച് ഒരു ഫോട്ടോയിൽ നിന്ന് അളവോടുകൂടിയ ടെക്സ്ചർ മുറി കണക്കാക്കുന്നു. ഇത് പൂർണ്ണ വോള്യൂമെട്രിക് പുനർനിർമ്മാണമല്ല.";
"faq.whatIsManualRoomAnswer" = "ഫലമായ പ്രതിനിധാനത്തിൽ കൂടുതൽ നിയന്ത്രണത്തിനായി ഫോട്ടോയിൽ നേരിട്ട് മുറിയുടെ അതിരുകൾ നിർവചിക്കാൻ Manual Setup അനുവദിക്കുന്നു.";
"faq.whichMethodBetterAnswer" = "വേഗത്തിലുള്ള സ്വയമേവ കണക്കിന് AI Room തിരഞ്ഞെടുക്കുക. മുറിയുടെ അതിരുകളിൽ നേരിട്ടുള്ള നിയന്ത്രണം വേണമെങ്കിൽ Manual Setup തിരഞ്ഞെടുക്കുക. ഒരു ഫലം അനുയോജ്യമല്ലെങ്കിൽ മറ്റേ രീതി പരീക്ഷിക്കുക.";
"faq.howManyRoomsAnswer" = "നിങ്ങൾക്ക് 20 മുറികൾ വരെ സൂക്ഷിക്കാം. ഇടം ലഭിക്കാൻ ആവശ്യമില്ലാത്ത മുറികൾ ഇല്ലാതാക്കുക. മുറി ലൈബ്രറി നിലവിലെ മുറികളുടെ എണ്ണവും ഉപയോഗിച്ച ആകെ സംഭരണവും കാണിക്കുന്നു.";
"faq.whereRoomsSaved" = "എന്റെ മുറികൾ എവിടെയാണ് സൂക്ഷിക്കുന്നത്?";
"faq.whereRoomsSavedAnswer" = "മുറികൾ ഈ ഉപകരണത്തിലെ Paafekt-ന്റെ സ്വകാര്യ ആപ്പ് സംഭരണത്തിലാണ്; അവ സ്വയമേവ അപ്‌ലോഡ് ചെയ്യില്ല. ആന്തരിക സ്ഥാനം: Documents/SavedRooms.";
"faq.arePhotosUploaded" = "എന്റെ മുറിയുടെ ഫോട്ടോകൾ അപ്‌ലോഡ് ചെയ്യുമോ?";
"faq.arePhotosUploadedAnswer" = "ഇല്ല. മുറി സൃഷ്ടിക്കൽ, ഫർണിച്ചർ കണ്ടെത്തൽ, Placement Intelligence എന്നിവ ഈ ഉപകരണത്തിൽ നടക്കുന്നു. Firebase ഫോൺ-നമ്പർ സ്ഥിരീകരണവും ദുരുപയോഗ-പ്രതിരോധ ഡാറ്റയും പ്രത്യേകം പ്രോസസ്സ് ചെയ്യുന്നു. നിങ്ങൾ വ്യക്തമായി പങ്കിടുമ്പോൾ മാത്രം ഉള്ളടക്കം Paafekt-ൽ നിന്ന് പുറത്തുപോകും.";
"faq.aiFeatures" = "ഫർണിച്ചർ കണ്ടെത്തലും വലുപ്പനിർണ്ണയവും";
"faq.whatIsBrainIconAnswer" = "ഫർണിച്ചർ കണ്ടെത്തി 3D മുറിക്ക് മുകളിൽ സുതാര്യ കട്ട്‌ഔട്ട് സൃഷ്ടിക്കാൻ Fit ടാപ്പ് ചെയ്യുക. സ്ഥാനം മാറ്റാൻ കട്ട്‌ഔട്ട് വലിച്ചിടുക; വലുപ്പം മാറ്റാൻ പിഞ്ച് ചെയ്യുക. Fit ദൃശ്യ പ്രിവ്യൂ മാത്രമാണ്; അളവുകളുള്ള മാർഗ്ഗനിർദേശത്തിന് AR-സഹായിത വലുപ്പനിർണ്ണയം വേണം.";
"faq.whatIsSegmentationAnswer" = "ക്യാമറ കാഴ്ചയിലെ ഫർണിച്ചർ കണ്ടെത്തി അതിന്റെ ദൃശ്യ പിക്സലുകൾ പശ്ചാത്തലത്തിൽ നിന്ന് വേർതിരിച്ച് നീക്കാവുന്ന കട്ട്‌ഔട്ടാക്കുന്നതാണ് ഫർണിച്ചർ സെഗ്മെന്റേഷൻ. പ്രോസസ്സിംഗ് ഈ ഉപകരണത്തിൽ നടക്കുന്നു.";
"faq.accuracy" = "മുറിയുടെയും ഫർണിച്ചറിന്റെയും അളവുകൾ എത്ര കൃത്യമാണ്?";
"faq.accuracyAnswer" = "അളവുകൾ ഉപകരണത്തിൽ കണക്കാക്കുന്ന ഏകദേശ മൂല്യങ്ങളാണ്; ഫോട്ടോയുടെ ഗുണമേന്മ, വെളിച്ചം, ക്യാമറ കോണം, AR ട്രാക്കിംഗ് എന്നിവ അനുസരിച്ച് മാറാം. മാർഗ്ഗനിർദേശമായി മാത്രം ഉപയോഗിച്ച് പ്രധാന അളവുകൾ തീരുമാനങ്ങൾക്ക് മുമ്പ് സ്വയം സ്ഥിരീകരിക്കുക.";
"faq.arAssistedSizing" = "AR-സഹായിത വലുപ്പനിർണ്ണയം എന്താണ്?";
"faq.arAssistedSizingAnswer" = "പിന്തുണയുള്ള ക്യാമറ, ഡെപ്ത് കഴിവുകൾ ഉപയോഗിച്ച് ഫർണിച്ചറിന്റെ അളവുകൾ കണക്കാക്കുന്നതാണ് AR-സഹായിത വലുപ്പനിർണ്ണയം. ഫലങ്ങൾ ക്യാപ്ചർ ഗുണമേന്മയെയും ട്രാക്കിംഗ് സാഹചര്യങ്ങളെയും ആശ്രയിക്കുന്ന ഏകദേശ മൂല്യങ്ങളാണ്.";
"faq.multiplePiecesAnswer" = "പൂർണ്ണ-വീഡിയോ മോഡിൽ നിരവധി കണ്ടെത്തൽ ബോക്സുകൾ തിരഞ്ഞെടുത്ത് Segment ടാപ്പ് ചെയ്താൽ അവയുടെ കട്ട്‌ഔട്ടുകൾ ഒരുമിച്ച് സൃഷ്ടിക്കും. ഡിഫോൾട്ട് Fit പ്രവാഹത്തിൽ ഓരോ ഇനവും വേറെയും സെഗ്മെന്റ് ചെയ്യാം.";
