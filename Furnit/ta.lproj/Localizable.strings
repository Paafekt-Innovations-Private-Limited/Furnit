"faq.measurementsAccuracy" = "அளவீடுகள் மற்றும் துல்லியம்";
"faq.savedRoomsStorage" = "சேமித்த அறைகள் மற்றும் சேமிப்பகம்";
"faq.sharingExporting" = "பகிர்தல் மற்றும் ஏற்றுமதி";
