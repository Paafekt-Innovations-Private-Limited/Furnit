<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Paafekt dark theme -->
    <style name="Theme.Furnit" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/paafekt_accent</item>
        <item name="colorPrimaryVariant">@color/paafekt_accent_pressed</item>
        <item name="colorOnPrimary">@color/paafekt_accent_text</item>
        <item name="colorSecondary">@color/paafekt_accent</item>
        <item name="colorSecondaryVariant">@color/paafekt_accent_pressed</item>
        <item name="colorOnSecondary">@color/paafekt_accent_text</item>
        <item name="android:colorBackground">@color/paafekt_background</item>
        <item name="colorSurface">@color/paafekt_surface</item>
        <item name="colorOnSurface">@color/paafekt_text_primary</item>
        <item name="android:statusBarColor">@color/paafekt_background</item>
        <item name="android:navigationBarColor">@color/paafekt_background</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Dark dialog theme matching iOS -->
    <style name="DarkDialogTheme" parent="Theme.MaterialComponents.Dialog.Alert">
        <item name="android:background">@color/paafekt_surface</item>
        <item name="android:textColor">@color/paafekt_text_primary</item>
        <item name="android:textColorPrimary">@color/paafekt_text_primary</item>
        <item name="android:textColorSecondary">@color/paafekt_text_secondary</item>
        <item name="colorAccent">@color/paafekt_accent</item>
        <item name="buttonBarPositiveButtonStyle">@style/DarkDialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/DarkDialogButton</item>
    </style>

    <style name="DarkDialogButton" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/paafekt_accent</item>
    </style>

    <!-- Crash report activity: must extend AppCompat so AlertDialog works (process :crash). -->
    <style name="Theme.Furnit.CrashDialog" parent="Theme.MaterialComponents.Dialog.Alert">
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowBackground">#3A3A3C</item>
    </style>

    <!-- Full-screen theme for 3D viewer activities (matching iOS ignoresSafeArea) -->
    <style name="Theme.Furnit.FullScreen" parent="Theme.Furnit">
        <item name="android:windowFullscreen">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowTranslucentNavigation">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="p">shortEdges</item>
    </style>
</resources>
