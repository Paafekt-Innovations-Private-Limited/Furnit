            token inputs:varname = "st"
            float2 outputs:result
        }
        def Shader "DiffuseTexture" {
            uniform token info:id = "UsdUVTexture"
            asset inputs:file = @textures/loft_polished_concrete.png@
            token inputs:wrapS = "repeat"
            token inputs:wrapT = "repeat"
            float2 inputs:st.connect = </Room/Looks/floor/PrimvarReader_st.outputs:result>
            color3f outputs:rgb
        }
    }
    def Material "ceiling" {
        token outputs:surface.connect = </Room/Looks/ceiling/PreviewSurface.outputs:surface>
