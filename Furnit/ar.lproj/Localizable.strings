// FAQ overrides
"help.measurementAccuracyTitle" = "تنبيه القياس";
"help.measurementAccuracyBody" = "يمكن للهواتف التي لا تدعم عمق AR معاينة الغرف والأثاث، لكن قياسات الغرفة وخصوصاً الأثاث ستكون تقريبية فقط.";
"faq.whatIsBrainIconAnswer" = "Tap the gold Fit button (bottom-right) in the room viewer to start SmartyPants furniture segmentation. By default it auto-segments the highest-confidence item as a transparent cutout over your 3D room. Tap Done (top-right) to exit. For tap-to-select specific pieces, summon controls and enable full-video mode first.";
"faq.howToSegmentAnswer" = "Tap Fit in the room viewer. For a quick check it auto-segments the main item. To pick specific pieces: summon controls, enable full-video mode, point the camera at the furniture, tap detection boxes, then tap Segment. Tap Done (top-right) to exit.";
"faq.accuracyAnswer" = "الغرفة ثلاثية الأبعاد هي تقدير من صورة واحدة. قد تكون أبعاد الغرفة مفيدة كإرشاد، لكنها ليست قياسات دقيقة. قياس الأثاث يكون أوثق على الهواتف التي تدعم AR أو العمق.";
"faq.adjustDimensionsAnswer" = "You cannot edit AI room dimensions manually. After saving, summon controls and tap the ruler to see estimated width, height, and depth. During the pre-save preview, dimension chips are hidden—save the room first, then reopen to see measurements. Manual rooms follow the boundaries you draw.";
"faq.arAssistedSizingAnswer" = "Tap Fit to segment furniture first. Use the sizing control in the summoned toolbar when you want room-relative scale. On phones with AR/depth support, the app uses live camera depth; without depth, furniture measurements are approximate.";
"faq.measurementPillAnswer" = "تظهر قراءة حجم الأثاث فقط عند تفعيل وضع تغيير الحجم وعندما يحصل التطبيق على تقدير حي صالح للارتفاع. ويعرض زر المسطرة العرض والارتفاع والعمق الحاليين للغرفة في بطاقة صغيرة. وعلى الهواتف غير الداعمة لـ AR تكون هذه القراءات أقل موثوقية، خصوصاً للأثاث.";
"faq.resetOverlayScaleAnswer" = "There is no overflow menu now. If the overlay looks off, tap Done to exit Fit and tap Fit again, or pinch the furniture manually to fine-tune its size.";

"faq.pinchOverlaySize" = "ماذا يحدث عندما أقرّب أو أبعّد الأثاث المُقسَّم بإصبعيّ؟";
"faq.pinchOverlaySizeAnswer" = "التقريب أو الإبعاد يجعل طبقة الأثاث أكبر أو أصغر. إذا كان وضع تحديد الحجم مفعّلًا وكانت شارة Furni ظاهرة، فستتحدّث هذه الشارة إلى التقدير الحالي لحجم الأثاث بعد تغييره بالنسبة إلى الغرفة. وإذا كان وضع تحديد الحجم متوقفًا، فسيغيّر التقريب شكل الطبقة على الشاشة فقط.";

