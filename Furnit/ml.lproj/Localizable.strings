"faq.notDetectedAnswer" = "ഫർണിച്ചർ കണ്ടെത്തൽ വ്യക്തമായ, നല്ല വെളിച്ചമുള്ള ഫോട്ടോകളിൽ ഫർണിച്ചർ വ്യക്തമായി കാണുമ്പോൾ നന്നായി പ്രവർത്തിക്കുന്നു. ഫർണിച്ചർ ഭാഗികമായി മൂടപ്പെട്ടിട്ടില്ലെന്നോ പശ്ചാത്തലവുമായി കലർന്നിട്ടില്ലെന്നോ ഉറപ്പാക്കുക.";
"faq.multiplePieces" = "ഒന്നിലധികം ഫർണിച്ചർ കഷണങ്ങൾ സെഗ്മെന്റ് ചെയ്യാമോ?";

// FAQ - 3D Room & Fitment
"faq.howToView" = "എന്റെ 3D മുറി എങ്ങനെ കാണാം?";
"faq.howToViewAnswer" = "Tap any room on the home screen to open the 3D viewer. Drag to look around and pinch to zoom. Tap the room to summon extra controls (recenter, ruler, Capture). The gold Fit button stays visible at bottom-right.";
"faq.howToPlace" = "എന്റെ മുറിയിൽ ഫർണിച്ചർ എങ്ങനെ വയ്ക്കാം?";
"faq.howToPlaceAnswer" = "Segment ടാപ്പ് ചെയ്ത ശേഷം തിരഞ്ഞെടുത്ത ഫർണിച്ചർ മുറിയിൽ overlay ആയി കാണും. സ്ഥാനം മാറ്റാൻ drag ചെയ്യുക, വലിപ്പം മാറ്റാൻ pinch ചെയ്യുക, ദിശ മാറ്റാൻ rotate ചെയ്യുക.";
"faq.adjustDimensions" = "മുറി അളവുകൾ ക്രമീകരിക്കാമോ?";
"faq.adjustDimensionsAnswer" = "You cannot edit AI room dimensions manually. After saving, summon controls and tap the ruler to see estimated width, height, and depth. During the pre-save preview, dimension chips are hidden—save the room first, then reopen to see measurements. Manual rooms follow the boundaries you draw.";
"faq.measurementPill" = "ചെറിയ അളവ് വായന എന്താണ്?";
"faq.measurementPillAnswer" = "SmartyPants സജീവമാകുമ്പോൾ അനുമാനിച്ച ഫർണിച്ചർ, മുറി ഉയരം കാണാം. ടാപ്പ് ചെയ്ത് യഥാർത്ഥ അളവുകൾ നൽകുക. മുറി ഫോട്ടോ വൈഡ്-ആംഗിൾ (0.5×) ആണെങ്കിൽ അടയാളപ്പെടുത്തുക.";
"faq.resetOverlayScale" = "മാസ്ക് തെറ്റായി സൂം ചെയ്തതായി തോന്നുന്നുവോ?";
"faq.resetOverlayScaleAnswer" = "There is no overflow menu now. If the overlay looks off, tap Done to exit Fit and tap Fit again, or pinch the furniture manually to fine-tune its size.";
"faq.roomFitment" = "ഫർണിച്ചർ പൊരുത്തപ്പെടുന്നുണ്ടോ എങ്ങനെ പരിശോധിക്കാം?";
"faq.roomFitmentAnswer" = "segmentation-ന് ശേഷം 3D room-ൽ cutouts resize/reposition. full-video-ൽ Segment selected pieces room-ന്റെ മുകളിൽ composite ചെയ്ത് several items compare ചെയ്യാം.";

// FAQ - Placement intelligence & aesthetic
"faq.whatIsPlacementIntelligence" = "പ്ലേസ്മെന്റ് ഇന്റലിജൻസ് എന്താണ്?";
"faq.furnitureColorAesthetic" = "സൗന്ദര്യ സ്കോറിന് നിറം ആപ്പ് എങ്ങനെ തിരഞ്ഞെടുക്കുന്നു?";
"faq.furnitureColorAestheticAnswer" = "നിങ്ങൾ കാണുന്ന AI ഫർണിച്ചർ കട്ട്‌ഔട്ടിനുള്ളിൽ (അതേ സെഗ്‌മെന്റഡ് ഓവർലേ) കാണാവുന്ന പിക്സലുകളുടെ RGB ശരാശരി ആപ്പ് കണക്കാക്കി നിലം, മതിലുകൾ, മേൽക്കൂര എന്നിവയിൽ നിന്ന് സാമ്പിൾ ചെയ്ത നിറങ്ങളുമായി താരതമ്യം ചെയ്യുന്നു. കട്ട്‌ഔട്ട് തയ്യാറാകാത്ത പക്ഷം സെഗ്‌മെന്റേഷൻ യഥാർത്ഥ സാമ്പിൾ നൽകുന്നതുവരെ മുറിയുടെ പാലറ്റിൽ നിന്ന് ഫോൾബാക്ക് നിറം ഉപയോഗിക്കുന്നു.";
"faq.whatDoHarmonyContrastMean" = "ഹാർമണി, കോൺട്രാസ്റ്റ്, സ്റ്റൈൽ ഫിറ്റ് എന്നാൽ എന്ത്?";
"faq.whatDoHarmonyContrastMeanAnswer" = "ഇവ ലളിതമായ ഡിസൈൻ ഹ്യൂറിസ്റ്റിക്സാണ്, രുചിയുടെ വിധിയല്ല. ഹാർമണി ഫർണിച്ചർ നിറം മുറിയുടെ പാലറ്റുമായി എങ്ങനെ ബന്ധപ്പെടുന്നു എന്ന് വിവരിക്കുന്നു (ഉദാ. അടുത്തോ പൂരകവോ നിറങ്ങൾ). കോൺട്രാസ്റ്റ് സാധാരണ നിലമോ മതിലോ പ്രകാശവുമുള്ള വ്യത്യാസം അളക്കുന്നു. സ്റ്റൈൽ ഫിറ്റ് മുറിയിൽ നിന്ന് അനുമാനിച്ച വിശാലമായ ടാഗുകൾ ഡിഫോൾട്ട് മോഡേൺ പ്രൊഫൈലുമായി താരതമ്യം ചെയ്യുന്നു—അതിനാൽ അനുമാനം മാത്രം.";
"faq.whenDoesAestheticScoreLow" = "എപ്പോൾ സൗന്ദര്യ സ്കോർ കുറവായിത്തോന്നാം അല്ലെങ്കിൽ \"clash\" കാണാം?";
"faq.whenDoesAestheticScoreLowAnswer" = "തിളക്കമുള്ള, സംപൃക്ത വസ്തുക്കൾ പലപ്പോഴും കുറഞ്ഞ സ്കോർ നേടുന്നു അവയുടെ ഹ്യൂ ടോൺ നിങ്ങളുടെ മുറിയുടെ സാമ്പിളുമായി ആപ്പിന്റെ ഹാർമണി നിയമങ്ങളുമായി പൊരുത്തപ്പെടാത്തപ്പോൾ—ഉദാ. ആസിഡ് ഗ്രീൻ, മജന്റ, പർപ്പിൾ അല്ലെങ്കിൽ സേഫ്റ്റി-ഓറഞ്ച് ചൂട് ബേജ് അല്ലെങ്കിൽ തവിട്ട് മുറികളിൽ, അല്ലെങ്കിൽ ഏകവർണ്ണമായി സാമ്പിൾ ചെയ്ത മുറിയിൽ ഉച്ചസ്ഥായമായ പ്രൈമറി നിറങ്ങൾ. നിലമോ മതിലോ പ്രകാശവുമായി വളരെ സമാനം (തവിട്ടിൽ തവിട്ട്, ചാരത്തിൽ ചാരം) കോൺട്രാസ്റ്റ് കുറയ്ക്കാം നിങ്ങൾക്ക് ഇഷ്ടമുണ്ടെങ്കിലും. റസ്റ്റിക് അല്ലെങ്കിൽ പാരമ്പര്യ മുറികളിൽ സ്റ്റൈൽ ഫിറ്റ് കുറവായേക്കാം കാരണം ഫർണിച്ചർ പ്രൊഫൈൽ ഡിഫോൾട്ട് മോഡേൺ/മിനിമൽ ടാഗുകൾ ഉപയോഗിക്കുന്നു. തിരക്കുള്ള പശ്ചാത്തലത്തിൽ നിന്നുള്ള മങ്ങിയ ചാര നിറ ശരാശരി ചിലപ്പോൾ \"ന്യൂട്രൽ\" വലയത്തിൽ വീഴും clash അല്ല. സ്കോറുകൾ മാർഗദർശനം മാത്രം; യഥാർത്ഥ അലങ്കാരത്തിൽ നിങ്ങളുടെ കണ്ണിനെ വിശ്വസിക്കുക.";

