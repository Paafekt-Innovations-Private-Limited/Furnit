// FAQ - Room Creation
"faq.roomCreation" = "Primeros pasos";
"faq.howToCreate" = "¿Cómo creo una habitación?";
"faq.howToCreateAnswer" = "Toca Crear habitación y, a continuación, haz o elige una foto. Selecciona Habitación con IA para obtener una estimación automática o Configuración manual para definirla tú mismo. Guarda la habitación terminada para añadirla a tu Biblioteca de habitaciones.";
"faq.howToTakePhoto" = "¿Cómo tomo una foto para crear una habitación?";
"faq.howToTakePhotoAnswer" = "Al crear una habitación, elige Hacer una foto. Puedes seleccionar Estándar (1x) o Gran angular (ultra gran angular 0,5×). Mantén el dispositivo estable y toca el botón de captura. La foto se utiliza después para crear tu habitación 3D.";
"faq.twoMethods" = "¿En qué se diferencian Habitación con IA y Configuración manual?";
"faq.twoMethodsAnswer" = "Habitación con IA estima las dimensiones a partir de una foto y genera una representación texturizada con medidas. No es una reconstrucción volumétrica completa. Configuración manual te permite definir los límites de la habitación para obtener una representación más controlable.";
"faq.whatIsAIRoom" = "¿Qué es la habitación 3D con IA?";
"faq.whatIsAIRoomAnswer" = "Habitación con IA utiliza estimación de profundidad, referencias de muebles y calibración de cámara en el dispositivo para obtener a partir de una foto una habitación texturizada con medidas estimadas. No es una reconstrucción volumétrica completa.";
"faq.whatIsManualRoom" = "¿Qué es la configuración manual?";
"faq.whatIsManualRoomAnswer" = "Configuración manual te permite definir los límites de la habitación directamente sobre la foto para tener un mayor control sobre la representación resultante.";
"faq.whichMethodBetter" = "¿Qué método elijo?";
"faq.whichMethodBetterAnswer" = "Elige Habitación con IA para obtener una estimación automática más rápida. Elige Configuración manual si quieres controlar directamente los límites de la habitación. Si un resultado no es adecuado, prueba el otro método.";
"faq.bestPhotos" = "¿Qué tipo de fotos funcionan mejor?";
"faq.bestPhotosAnswer" = "Para mejores resultados, toma fotos con buena iluminación y la cámara en horizontal. Intenta capturar toda la habitación incluyendo suelos, paredes y bordes del techo. Evita fotos borrosas u oscuras.";
"faq.generationFailing" = "¿Por qué falla la generación de mi habitación?";
"faq.generationFailingAnswer" = "La generación de habitación puede fallar si la foto es demasiado oscura, borrosa o no muestra suficientes características de la habitación. Intenta tomar una nueva foto con mejor iluminación y un ángulo más amplio.";
"faq.howManyRooms" = "¿Cuántas habitaciones puedo crear?";
"faq.howManyRoomsAnswer" = "Puedes guardar hasta 20 habitaciones. Elimina las que ya no necesites para liberar espacio. La Biblioteca de habitaciones muestra el número actual y el almacenamiento total utilizado.";
"faq.howToSaveRoom" = "¿Cómo guardo una habitación?";
"faq.howToSaveRoomAnswer" = "Después de generar una habitación 3D, toca la habitación para mostrar los controles, pulsa el icono de guardar (flecha de descarga) e introduce un nombre. Si sales de la vista previa sin guardar, la habitación se descarta.";
"faq.whereRoomsSaved" = "¿Dónde se guardan mis habitaciones?";
"faq.whereRoomsSavedAnswer" = "Las habitaciones se almacenan en el espacio privado de Paafekt en este dispositivo y no se suben automáticamente. Ubicación interna: Documents/SavedRooms.";
"faq.arePhotosUploaded" = "¿Se suben las fotos de mis habitaciones?";
"faq.arePhotosUploadedAnswer" = "No. La creación de habitaciones, la detección de muebles y Placement Intelligence se ejecutan en este dispositivo. Por separado, Firebase procesa el número de teléfono para la autenticación y datos para prevenir abusos. El contenido solo sale de Paafekt cuando lo compartes expresamente.";

// FAQ - AI Features
"faq.aiFeatures" = "Detección y dimensionamiento de muebles";
"faq.whatIsBrainIcon" = "¿Qué hace el botón Fit?";
"faq.whatIsBrainIconAnswer" = "Toca Fit para detectar un mueble y crear un recorte transparente sobre tu habitación 3D. Arrastra el recorte para colocarlo y pellízcalo para cambiar su tamaño. Fit es una vista previa visual; las indicaciones con medidas requieren el dimensionamiento asistido por AR.";
"faq.whatIsViewfinderButton" = "¿Qué hace el modo de vídeo completo en el visor de habitaciones?";
"faq.whatIsViewfinderButtonAnswer" = "Mientras Fit esté activo, muestra los controles y toca el icono del visor para activar o desactivar el modo de vídeo completo. Verás la cámara en directo con recuadros de detección: toca uno o varios objetos y después Segmentar. La cámara se oculta y los recortes transparentes se superponen a tu habitación 3D. Toca Hecho (arriba a la derecha) para salir del modo de segmentación o de Fit.";
"faq.howToScreenshot" = "¿Cómo tomo una captura de pantalla?";
"faq.howToScreenshotAnswer" = "Toca la habitación para mostrar controles y luego Capturar. Guarda la vista actual (incluidos overlays de muebles con Fit activo) en Fotos.";
"faq.whatIsSegmentation" = "¿Qué es la segmentación de muebles?";
"faq.whatIsSegmentationAnswer" = "La segmentación de muebles detecta un objeto en la vista de la cámara y separa sus píxeles visibles del fondo para mostrarlo como un recorte móvil. El procesamiento se realiza en este dispositivo.";
"faq.howToSegment" = "¿Cómo segmento muebles en el visor de la habitación?";
"faq.howToSegmentAnswer" = "Toca Fit en el visor de habitaciones. Para una comprobación rápida, se segmenta automáticamente el objeto principal. Para elegir objetos concretos, muestra los controles, activa el modo de vídeo completo, apunta la cámara a los muebles, toca los recuadros de detección y después Segmentar. Toca Hecho (arriba a la derecha) para salir.";
"faq.notDetected" = "¿Por qué no se detectan mis muebles?";
"faq.notDetectedAnswer" = "La detección de muebles funciona mejor con fotos claras y bien iluminadas donde los muebles son claramente visibles. Asegúrate de que los muebles no estén parcialmente ocultos o se confundan con el fondo.";

// FAQ - 3D Room Controls
"faq.howToView" = "¿Cómo veo mi habitación 3D?";
"faq.howToViewAnswer" = "Toca cualquier habitación en inicio para abrir el visor 3D. Arrastra para mirar y pellizca para zoom. Toca la habitación para más controles (recentrar, regla, Capturar). El botón Fit dorado permanece visible abajo a la derecha.";
"faq.howToNavigate" = "¿Cómo navego dentro de la habitación?";
"faq.howToNavigateAnswer" = "Drag on the room to orbit the camera and pinch to zoom. Tap the screen to summon the toolbar, then use the viewfinder icon to recenter. A quiet summon disk at bottom-left also brings controls back when hidden.";
"faq.whatDoArrowsDo" = "¿Cómo mostrar u ocultar los controles del visor?";
"faq.whatDoArrowsDoAnswer" = "El visor usa modo inmersivo—los controles se ocultan para una vista limpia. Toca la habitación para mostrar la barra. El botón Fit dorado abajo a la derecha siempre está visible. Con Fit activo, Hecho aparece arriba a la derecha para salir de la segmentación.";
"faq.whatIsMemoryDisplay" = "¿Qué significa el número MB?";
"faq.whatIsMemoryDisplayAnswer" = "El MB (megabytes) mostrado en las habitaciones indica el tamaño del archivo. Esto te ayuda a administrar el almacenamiento. El almacenamiento total usado por todas las habitaciones se muestra en la parte superior de la pantalla de inicio.";
"faq.howToPlace" = "¿Cómo coloco muebles en mi habitación?";
"faq.howToPlaceAnswer" = "Después de tocar Segmentar, el mueble seleccionado aparece como una superposición en la habitación. Arrástralo para colocarlo, pellizca para cambiar el tamaño y gíralo para ajustar la orientación.";
"faq.accuracy" = "¿Qué precisión tienen las medidas de la habitación y los muebles?";
"faq.accuracyAnswer" = "Las medidas son estimaciones realizadas en el dispositivo y pueden variar según la calidad de la foto, la iluminación, el ángulo de la cámara y el seguimiento de AR. Úsalas como orientación y comprueba por tu cuenta las dimensiones importantes antes de tomar decisiones.";
"faq.adjustDimensions" = "¿Puedo ajustar las dimensiones de la habitación?";
"faq.adjustDimensionsAnswer" = "No puedes editar manualmente las dimensiones de una habitación con IA. Después de guardarla, muestra los controles y toca la regla para ver la anchura, la altura y la profundidad estimadas. Durante la vista previa previa al guardado no se muestran las etiquetas de dimensiones: guarda primero la habitación y vuelve a abrirla. Las habitaciones manuales siguen los límites que dibujes.";
"faq.arAssistedSizing" = "¿Qué es el dimensionamiento asistido por AR?";
"faq.arAssistedSizingAnswer" = "El dimensionamiento asistido por AR estima las dimensiones de un mueble mediante las funciones de cámara y profundidad compatibles. Los resultados dependen de la calidad de la captura y de las condiciones de seguimiento, y siguen siendo estimaciones.";
"faq.measurementPill" = "¿Qué es la pequeña lectura de medidas?";
"faq.measurementPillAnswer" = "La pastilla de tamaño del mueble solo aparece cuando el modo de tamaño está activado y la app tiene una estimación de altura en vivo válida. El botón de regla muestra el ancho, alto y fondo actuales de la habitación en una tarjeta pequeña. En teléfonos sin AR, estas lecturas son menos fiables, especialmente para los muebles.";
"faq.resetOverlayScale" = "La máscara parece mal ampliada — ¿qué hago?";
"faq.resetOverlayScaleAnswer" = "Ya no hay un menú adicional. Si la superposición no se ve bien, toca Hecho para salir de Fit y vuelve a tocar Fit, o pellizca el mueble para ajustar manualmente su tamaño.";
"faq.depthAwareRoomPhoto" = "¿Ayuda tomar la foto dentro de la app?";
"faq.depthAwareRoomPhotoAnswer" = "Sí. En dispositivos compatibles, «Tomar una foto» (en lugar de la galería) usa la cámara de la app con profundidad si está disponible, lo que puede mejorar la escala y reconstrucción 3D.";
"faq.multiplePieces" = "¿Puedo segmentar múltiples muebles?";
"faq.multiplePiecesAnswer" = "En el modo de vídeo completo, selecciona varios recuadros de detección y toca Segmentar para crear sus recortes a la vez. También puedes segmentar los objetos de uno en uno con el flujo predeterminado de Fit.";
"faq.roomFitment" = "¿Cómo compruebo si el mueble encaja?";
"faq.roomFitmentAnswer" = "Tras la segmentación, activa el dimensionamiento AR para medir la anchura y la altura del mueble. Placement Intelligence compara esos valores y la profundidad calculada con el volumen de la habitación. No identifica una ubicación libre garantizada en el suelo.";

// FAQ - Placement intelligence & aesthetic
"faq.placementIntelligence" = "Placement Intelligence";
"faq.whatIsPlacementIntelligence" = "¿Qué es Placement Intelligence?";
"faq.whatIsPlacementIntelligenceAnswer" = "Placement Intelligence compara la anchura y la altura estimadas de un objeto, así como su profundidad calculada, con el volumen de la habitación. Solo informa de la compatibilidad dimensional; no identifica una ubicación libre en el suelo.";
"faq.furnitureColorAesthetic" = "¿Cómo elige la app un color para la puntuación estética?";
"faq.furnitureColorAestheticAnswer" = "La app calcula el promedio RGB directo de los píxeles visibles dentro del recorte de muebles generado por IA y lo compara con colores muestreados de la habitación. Si alguna de las muestras no está disponible, la orientación estética permanece desactivada en lugar de inventar una puntuación.";
"faq.whatDoHarmonyContrastMean" = "¿Qué significan armonía, contraste y ajuste de estilo?";
"faq.whatDoHarmonyContrastMeanAnswer" = "Son heurísticas de diseño sencillas, no un juicio de gusto. La armonía describe cómo se relaciona el color del mueble con la paleta de la habitación (por ejemplo tonos análogos o complementarios). El contraste mide cuánto difiere el brillo respecto a suelos o paredes típicos. El ajuste de estilo compara etiquetas de estilo amplias inferidas para la habitación con un perfil moderno por defecto, así que es aproximado.";
"faq.whenDoesAestheticScoreLow" = "¿Cuándo pueden verse bajas las puntuaciones estéticas o aparecer \"clash\"?";
"faq.whenDoesAestheticScoreLowAnswer" = "Los objetos muy saturados suelen puntuar peor si su matiz no encaja con los esquemas armónicos de la app frente a tu habitación: por ejemplo verde ácido, magenta, morado o naranja de seguridad en salones cálidos beige o tostados, o primarios chillones cuando la muestra del espacio es casi monocromática. Un brillo muy parecido al suelo o la pared (marrón sobre marrón, gris sobre gris) puede bajar el contraste aunque te guste el resultado. Las habitaciones inferidas como rústicas o tradicionales pueden mostrar menos ajuste de estilo porque el perfil del mueble usa etiquetas modernas/minimal por defecto. Promedios grises o sucios con fondos cargados pueden caer en una banda \"neutral\" en lugar de clash. Las puntuaciones son solo orientativas: para decorar de verdad, confía también en tu ojo.";
