// FAQ - Room Creation
"faq.roomCreation" = "कमरा निर्माण";
"faq.howToCreate" = "मैं रूम कैसे बनाऊँ?";
"faq.howToCreateAnswer" = "रूम बनाएँ पर टैप करें, फिर फ़ोटो लें या चुनें। अपने-आप अनुमान के लिए AI Room या स्वयं रूम निर्धारित करने के लिए मैनुअल सेटअप चुनें। तैयार रूम को रूम लाइब्रेरी में जोड़ने के लिए सहेजें।";
"faq.howToTakePhoto" = "कमरा बनाने के लिए फोटो कैसे लें?";
"faq.howToTakePhotoAnswer" = "कमरा बनाते समय Take a Photo चुनें। Standard (1x) या Wide Angle (0.5×) चुन सकते हैं। डिवाइस स्थिर रखकर कैप्चर टैप करें। फोटो आपके 3D कमरे के निर्माण में उपयोग होगी।";
"faq.depthAwareRoomPhoto" = "क्या ऐप में फोटो लेने से कमरे की गुणवत्ता बेहतर होती है?";
"faq.depthAwareRoomPhotoAnswer" = "हाँ। समर्थित डिवाइसों पर गैलरी के बजाय Take a photo इन-ऐप कैमरा और उपलब्ध होने पर गहराई का उपयोग करता है, जिससे 3D कमरा बेहतर बन सकता है।";
"faq.twoMethods" = "AI Room और मैनुअल सेटअप में क्या अंतर है?";
"faq.twoMethodsAnswer" = "AI Room एक फ़ोटो से रूम के आयामों का अनुमान लगाकर मापयुक्त, टेक्सचरयुक्त रूप बनाता है। यह पूर्ण वॉल्यूमेट्रिक पुनर्निर्माण नहीं है। मैनुअल सेटअप में आप अधिक नियंत्रित रूप के लिए रूम की सीमाएँ स्वयं तय कर सकते हैं।";
"faq.whatIsAIRoom" = "AI-संचालित 3D रूम क्या है?";
"faq.whatIsAIRoomAnswer" = "AI Room डिवाइस पर गहराई के अनुमान, फर्नीचर एंकर और कैमरा कैलिब्रेशन से एक फ़ोटो के आधार पर मापयुक्त, टेक्सचरयुक्त रूम का अनुमान लगाता है। यह पूर्ण वॉल्यूमेट्रिक पुनर्निर्माण नहीं है।";
"faq.whatIsManualRoom" = "मैनुअल सेटअप क्या है?";
"faq.whatIsManualRoomAnswer" = "मैनुअल सेटअप में आप फोटो पर कमरे की दीवारों का आउटलाइन खींचते हैं। इससे 3D कमरे का लुक आप खुद तय कर सकते हैं। कमरे का आकार खुद ठीक करने के लिए बढ़िया है।";
"faq.whichMethodBetter" = "मुझे कौन सा तरीका चुनना चाहिए?";
"faq.whichMethodBetterAnswer" = "पहले AI वाला आज़माएं – तेज़ है और ज़्यादातर कमरों के लिए अच्छा काम करता है। अगर नतीजा ठीक न लगे तो मैनुअल सेटअप से दीवारें जहाँ चाहें खींचें। दोनों आज़मा सकते हैं!";
"faq.bestPhotos" = "किस तरह की फोटो सबसे अच्छी काम करती हैं?";
"faq.bestPhotosAnswer" = "सर्वोत्तम परिणामों के लिए, अच्छी रोशनी में कैमरा समतल रखकर फोटो लें। फर्श, दीवारों और छत के किनारों सहित पूरे कमरे को कैप्चर करने का प्रयास करें। धुंधली या अंधेरी फोटो से बचें।";
"faq.generationFailing" = "मेरा कमरा जनरेशन क्यों विफल हो रहा है?";
"faq.generationFailingAnswer" = "यदि फोटो बहुत अंधेरी, धुंधली है या पर्याप्त कमरे की विशेषताएं नहीं दिखाती है तो कमरा जनरेशन विफल हो सकता है। बेहतर रोशनी और व्यापक कोण के साथ नई फोटो लेने का प्रयास करें।";
"faq.howManyRooms" = "मैं कितने कमरे बना सकता हूं?";
"faq.howManyRoomsAnswer" = "आप अधिकतम 20 रूम सहेज सकते हैं। जगह बनाने के लिए जिन रूम की जरूरत नहीं है उन्हें हटाएँ। रूम लाइब्रेरी में मौजूदा रूम संख्या और कुल उपयोग किया गया स्टोरेज दिखता है।";

// FAQ - Furniture Detection & Sizing
"faq.aiFeatures" = "फर्नीचर पहचान और आकार निर्धारण";
"faq.whatIsBrainIcon" = "Fit बटन क्या करता है?";
"faq.whatIsBrainIconAnswer" = "फर्नीचर पहचानकर 3D रूम के ऊपर पारदर्शी कटआउट बनाने के लिए Fit टैप करें। कटआउट की जगह बदलने के लिए खींचें और आकार बदलने के लिए पिंच करें। Fit एक दृश्य पूर्वावलोकन है; मापयुक्त आयामी मार्गदर्शन के लिए AR-सहायित साइजिंग चाहिए।";
"faq.whatIsViewfinderButton" = "रूम व्यूअर में पूर्ण-वीडियो मोड क्या करता है?";
"faq.whatIsViewfinderButtonAnswer" = "Fit चालू होने पर नियंत्रण दिखाएँ और पूर्ण-वीडियो मोड टॉगल करने के लिए व्यूफाइंडर आइकन टैप करें। पहचान बॉक्स वाले लाइव कैमरा फ़ीड में एक या अधिक वस्तुएँ टैप करके Segment दबाएँ। कैमरा छिप जाता है और पारदर्शी कटआउट 3D रूम पर दिखाई देते हैं। बाहर निकलने के लिए ऊपर-दाएँ हो गया टैप करें।";
"faq.howToScreenshot" = "मैं स्क्रीनशॉट कैसे लूँ?";
"faq.howToScreenshotAnswer" = "नियंत्रण दिखाने के लिए रूम पर टैप करें, फिर Capture टैप करें। इससे मौजूदा दृश्य—Fit चालू होने पर फर्नीचर ओवरले सहित—Photos लाइब्रेरी में सहेजा जाता है।";
"faq.howToSaveRoom" = "मैं रूम कैसे सहेजूँ?";
"faq.howToSaveRoomAnswer" = "3D रूम बनने के बाद नियंत्रण दिखाने के लिए रूम पर टैप करें, फिर सहेजें आइकन (डाउनलोड तीर) टैप करके नाम दर्ज करें। बिना सहेजे पूर्वावलोकन छोड़ने पर वह रूम हटा दिया जाता है।";

// FAQ - Furniture Segmentation
"faq.whatIsSegmentation" = "फर्नीचर सेगमेंटेशन क्या है?";
"faq.whatIsSegmentationAnswer" = "रूम व्यूअर में Fit बटन से फर्नीचर segmentation चलता है। डिफ़ॉल्ट रूप में एक primary आइटम auto-segment होता है। full-video mode में पहले आइटम चुनें; Segment केवल चुने गए pieces के cutouts बनाता है।";
"faq.howToSegment" = "रूम व्यूअर में फर्नीचर कैसे सेगमेंट करें?";
"faq.howToSegmentAnswer" = "रूम व्यूअर में Fit टैप करें। जल्दी जाँच के लिए मुख्य आइटम auto-segment होता है। खास pieces के लिए: नियंत्रण बुलाएँ, full-video mode चालू करें, कैमरा फर्नीचर की ओर करें, boxes टैप करें, फिर Segment। बाहर निकलने के लिए ऊपर-दाएँ Done टैप करें।";
"faq.notDetected" = "मेरा फर्नीचर क्यों नहीं पहचाना जा रहा?";
"faq.notDetectedAnswer" = "फर्नीचर पहचान स्पष्ट, अच्छी रोशनी वाली फोटो में सबसे अच्छा काम करती है जहां फर्नीचर स्पष्ट रूप से दिखाई देता है। सुनिश्चित करें कि फर्नीचर आंशिक रूप से छिपा नहीं है या पृष्ठभूमि के साथ मिश्रित नहीं है।";
"faq.multiplePieces" = "क्या मैं एक से अधिक फर्नीचर पीस सेगमेंट कर सकता हूं?";
"faq.multiplePiecesAnswer" = "हाँ! full-video mode में कई detection boxes टैप करके एक बार Segment—सभी चुने pieces एक साथ 3D कमरे पर। default Fit flow से एक-एक करके भी segment कर सकते हैं।";

// FAQ - 3D Room & Fitment
"faq.howToView" = "अपना 3D कमरा कैसे देखें?";
"faq.howToViewAnswer" = "होम स्क्रीन पर किसी भी कमरे को टैप करके 3D व्यूअर खोलें। देखने के लिए खींचें, ज़ूम के लिए पिंच करें। अतिरिक्त नियंत्रण (recenter, ruler, Capture) के लिए कमरे पर टैप करें। नीचे-दाएँ सुनहरा Fit बटन हमेशा दिखता है।";
"faq.howToPlace" = "अपने कमरे में फर्नीचर कैसे रखें?";
"faq.howToPlaceAnswer" = "Segment टैप करने के बाद चुना हुआ फर्नीचर कमरे में overlay के रूप में दिखता है। पोजिशन करने के लिए ड्रैग करें, आकार बदलने के लिए पिंच करें, और दिशा बदलने के लिए रोटेट करें।";
"faq.accuracy" = "3D मॉडल कितना सटीक है?";
"faq.accuracyAnswer" = "माप डिवाइस पर किए गए अनुमान हैं और फ़ोटो की गुणवत्ता, रोशनी, कैमरा कोण तथा AR ट्रैकिंग के अनुसार बदल सकते हैं। इन्हें मार्गदर्शन मानें और निर्णय लेने से पहले महत्वपूर्ण आयाम स्वयं जाँचें।";
"faq.adjustDimensions" = "क्या मैं कमरे के आयाम समायोजित कर सकता हूं?";
"faq.adjustDimensionsAnswer" = "AI कमरे के आयाम मैन्युअल संपादित नहीं कर सकते। सेव के बाद नियंत्रण बुलाकर ruler से अनुमानित चौड़ाई, ऊँचाई, गहराई देखें। pre-save प्रीव्यू में dimension chips छिपे रहते हैं—पहले सेव करें, फिर दोबारा खोलकर माप देखें। manual कमरे आपकी सीमाओं का पालन करते हैं।";
"faq.arAssistedSizing" = "AR-सहायता वाला फर्नीचर साइज़िंग क्या है?";
"faq.arAssistedSizingAnswer" = "पहले Fit से फर्नीचर segment करें। room-relative स्केल के लिए summoned toolbar में sizing control उपयोग करें। AR/depth फ़ोन live camera depth उपयोग करते हैं; बिना depth माप अनुमानित रहते हैं।";
"faq.measurementPill" = "छोटा माप रीडआउट क्या है?";
"faq.measurementPillAnswer" = "SmartyPants चालू होने पर अनुमानित फर्नीचर और कमरे की ऊँचाई दिख सकती है। सटीकता के लिए टैप करके वास्तविक माप दर्ज करें। अगर कमरे की फोटो वाइड-एंगल (0.5×) से ली गई हो तो उसे चिह्नित करें।";
"faq.resetOverlayScale" = "मास्क गलत ज़ूम लग रहा है—क्या करें?";
"faq.resetOverlayScaleAnswer" = "अब overflow menu नहीं है। overlay गलत लगे तो Done से Fit बंद करके फिर Fit टैप करें, या pinch से आकार ठीक करें।";
"faq.roomFitment" = "फर्नीचर फिट है या नहीं कैसे जांचें?";
"faq.roomFitmentAnswer" = "सेगमेंटेशन के बाद 3D कमरे में कटआउट का आकार बदलें और स्थान बदलें। full-video में Segment चुने हुए टुकड़े कमरे पर रखकर कई आइटम एक साथ तुलना करने देता है।";

// FAQ - Placement intelligence & aesthetic
"faq.placementIntelligence" = "प्लेसमेंट इंटेलिजेंस और सौंदर्य";
"faq.whatIsPlacementIntelligence" = "प्लेसमेंट इंटेलिजेंस क्या है?";
"faq.whatIsPlacementIntelligenceAnswer" = "Placement Intelligence किसी वस्तु की अनुमानित चौड़ाई, ऊँचाई और निकाली गई गहराई की तुलना रूम की सीमा से करता है। यह केवल आयामी अनुकूलता बताता है और फर्श पर खाली स्थान नहीं खोजता।";
"faq.furnitureColorAesthetic" = "ऐस्थेटिक स्कोर के लिए रंग कैसे चुना जाता है?";
"faq.furnitureColorAestheticAnswer" = "ऐप AI फर्नीचर कटआउट के भीतर दिखाई देने वाले पिक्सेल का सीधा औसत RGB रंग निकालकर रूम से लिए रंगों से तुलना करता है। कोई नमूना न मिले तो बनावटी स्कोर दिखाने के बजाय सौंदर्य मार्गदर्शन उपलब्ध नहीं रहता।";
"faq.whatDoHarmonyContrastMean" = "हार्मनी, कंट्रास्ट और स्टाइल फिट का क्या मतलब है?";
"faq.whatDoHarmonyContrastMeanAnswer" = "ये सरल डिज़ाइन नियम हैं, स्वाद का फैसला नहीं। हार्मनी बताता है कि फर्नीचर का रंग कमरे की पैलेट से कैसे जुड़ता है (जैसे समान या पूरक रंग)। कंट्रास्ट सामान्य फर्श या दीवार की चमक से अंतर मापता है। स्टाइल फिट कमरे के चौड़े स्टाइल टैग को डिफ़ॉल्ट आधुनिक प्रोफ़ाइल से मिलाता है—इसलिए अनुमानित है।";
"faq.whenDoesAestheticScoreLow" = "ऐस्थेटिक स्कोर कब कम दिख सकता है या \"clash\" दिख सकता है?";
"faq.whenDoesAestheticScoreLowAnswer" = "चमकीले, संतृप्त वस्तुएँ अक्सर कम स्कोर पाती हैं जब उनका रंग टोन आपके कमरे के सैंपल के मुकाबले ऐप के सामंजस्य नियमों से न मिले—जैसे एसिड ग्रीन, मैजेंटा, बैंगनी या सेफ्टी-ऑरेंज गर्म बेज या भूरे कमरे में, या लगभग एक ही रंग के कमरे में ज़ोरदार प्राइमरी। फर्श या दीवार से बहुत मिलती चमक (भूरे पर भूरा, ग्रे पर ग्रे) कंट्रास्ट घटा सकती है भले ही आपको पसंद हो। रस्टिक या पारंपरिक कमरों में स्टाइल फिट कम हो सकता है क्योंकि फर्नीचर प्रोफ़ाइल में डिफ़ॉल्ट आधुनिक/मिनिमल टैग होते हैं। व्यस्त पृष्ठभूमि से धूसर औसत कभी-कभी \"न्यूट्रल\" बैंड में आता है, clash नहीं। स्कोर केवल मार्गदर्शन हैं; असली सजावट में अपनी आँख पर भरोसा करें।";
"faq.aiRoomManualSetup" = "AI Room और मैनुअल सेटअप";
"faq.aestheticGuidance" = "सौंदर्य मार्गदर्शन";
"faq.aestheticScore" = "सौंदर्य स्कोर कैसे निकाला जाता है?";
"faq.aestheticScoreAnswer" = "ऐप सेगमेंट किए गए फर्नीचर के औसत दिखाई देने वाले रंग की तुलना रूम से लिए गए रंगों से करता है। रंग सामंजस्य, चमक का कंट्रास्ट और व्यापक शैली अनुकूलता स्कोर में योगदान देते हैं। ये अनुमानित डिज़ाइन संकेत हैं, पसंद के नियम नहीं।";
"faq.aestheticUnavailable" = "सौंदर्य मार्गदर्शन उपलब्ध क्यों नहीं है?";
"faq.aestheticUnavailableAnswer" = "सौंदर्य मार्गदर्शन के लिए रूम और सेगमेंट किए फर्नीचर दोनों से उपयोगी रंग नमूने चाहिए। कोई नमूना उपलब्ध न हो तो Paafekt मनगढ़ंत स्कोर नहीं दिखाता।";
"faq.freeFloorLocation" = "क्या Placement Intelligence फर्श पर उपलब्ध जगह खोजता है?";
"faq.freeFloorLocationAnswer" = "नहीं। यह जाँचता है कि अनुमानित फर्नीचर आयाम रूम की सीमा के अनुकूल हैं या नहीं। यह खाली फर्श नहीं पहचानता और न ही कोई खास खुली जगह बताता है।";
"faq.dimensionalFit" = "आयामी फिट कैसे निकाला जाता है?";
"faq.dimensionalFitAnswer" = "वस्तु की अनुमानित चौड़ाई, ऊँचाई और निकाली गई गहराई की तुलना रूम के अनुमानित आयामों से की जाती है; जहाँ उपयोगी हो वहाँ घुमाए गए आधार को भी देखा जाता है। दोनों आयाम अनुमानित हैं, इसलिए परिणाम को मार्गदर्शन मानें।";
"faq.measurementsAccuracy" = "माप और सटीकता";
"faq.purchaseReliance" = "क्या फर्नीचर खरीदते समय मैं Paafekt पर निर्भर कर सकता हूँ?";
"faq.purchaseRelianceAnswer" = "Paafekt को मार्गदर्शन मानें, गारंटी नहीं। खरीदने से पहले विक्रेता से आयाम, खाली जगह और उपयुक्तता हमेशा पक्की करें।";
"faq.savedRoomsStorage" = "सहेजे गए रूम और स्टोरेज";
"faq.whereRoomsSaved" = "मेरे रूम कहाँ सहेजे जाते हैं?";
"faq.whereRoomsSavedAnswer" = "रूम इस डिवाइस पर Paafekt के निजी ऐप स्टोरेज में रहते हैं और अपने-आप अपलोड नहीं होते। आंतरिक स्थान: Documents/SavedRooms.";
"faq.uninstallRooms" = "Paafekt अनइंस्टॉल करने पर मेरे रूम का क्या होगा?";
"faq.uninstallRoomsAnswer" = "Paafekt अनइंस्टॉल करने पर उसके निजी ऐप स्टोरेज में रखे रूम स्थायी रूप से हट जाते हैं। जिन्हें रखना है उन्हें अनइंस्टॉल करने से पहले साझा करें।";
"faq.sharingExporting" = "साझा करना और निर्यात";
"faq.exportRoom" = "मैं किसी रूम का बैकअप या निर्यात कैसे करूँ?";
"faq.exportRoomAnswer" = "उस रूम प्रकार के लिए Share उपलब्ध हो तो उसका उपयोग करें। Capture मौजूदा दृश्य की छवि साझा करता है, पुनर्स्थापित किया जा सकने वाला रूम बैकअप नहीं। Paafekt अभी क्लाउड सिंक या पूरी लाइब्रेरी का सुनिश्चित बैकअप नहीं देता।";
"faq.privacyAccount" = "गोपनीयता और खाता";
"faq.arePhotosUploaded" = "क्या मेरे रूम की फ़ोटो अपलोड होती हैं?";
"faq.arePhotosUploadedAnswer" = "नहीं। रूम बनाना, फर्नीचर पहचान और Placement Intelligence इस डिवाइस पर चलते हैं। Firebase अलग से फ़ोन नंबर प्रमाणीकरण और दुरुपयोग-रोकथाम डेटा प्रोसेस करता है। सामग्री Paafekt से तभी बाहर जाती है जब आप उसे स्पष्ट रूप से साझा करते हैं।";
"faq.firebaseData" = "Firebase कौन-सा डेटा प्रोसेस करता है?";
"faq.firebaseDataAnswer" = "Firebase आपका फ़ोन नंबर, प्रमाणीकरण रिकॉर्ड और सत्यापन तथा दुरुपयोग रोकने के लिए प्रयुक्त डिवाइस इंस्टॉलेशन पहचानकर्ता प्रोसेस करता है। रूम निर्माण और फर्नीचर प्रोसेसिंग इस डिवाइस पर रहती है।";
"faq.deleteAccountEffect" = "खाता हटाने पर क्या होता है?";
"faq.deleteAccountEffectAnswer" = "खाता हटाने पर Firebase प्रमाणीकरण खाता हटता है और आपको साइन आउट कर दिया जाता है। इस डिवाइस पर सहेजे रूम अपने-आप नहीं हटते; उन्हें Paafekt में हटाएँ या ऐप अनइंस्टॉल करें।";
"faq.troubleshootingSupport" = "समस्या निवारण और सहायता";
"faq.contactSupport" = "मैं सहायता से कैसे संपर्क करूँ?";
"faq.contactSupportAnswer" = "सेटिंग्स → सहायता और समर्थन खोलें, फिर support@paafekt.com पर ईमेल करें।";
"faq.howToNavigate" = "मैं रूम के अंदर कैसे चलूँ?";
"faq.howToNavigateAnswer" = "कैमरा घुमाने के लिए रूम पर खींचें और ज़ूम करने के लिए पिंच करें। टूलबार दिखाने के लिए स्क्रीन टैप करें, फिर डिफ़ॉल्ट दृश्य लौटाने के लिए रीसेंटर टैप करें। नियंत्रण छिपे होने पर नीचे-बाएँ छोटा नियंत्रण भी टूलबार वापस लाता है।";
"faq.whatDoArrowsDo" = "व्यूअर नियंत्रण कैसे दिखाएँ या छिपाएँ?";
"faq.whatDoArrowsDoAnswer" = "रूम व्यूअर इमर्सिव मोड का उपयोग करता है—साफ दृश्य के लिए नियंत्रण छिप जाते हैं। टूलबार दिखाने के लिए रूम पर टैप करें। नीचे-दाएँ सुनहरा Fit बटन हमेशा दिखता है। Fit चालू होने पर सेगमेंटेशन से बाहर निकलने के लिए ऊपर-दाएँ हो गया दिखाई देता है।";
"faq.whatIsMemoryDisplay" = "MB संख्या का क्या अर्थ है?";
"faq.whatIsMemoryDisplayAnswer" = "रूम में दिखाया गया MB (मेगाबाइट) फ़ाइल का आकार बताता है और स्टोरेज प्रबंधित करने में मदद करता है। सभी रूम द्वारा उपयोग किया गया कुल स्टोरेज होम स्क्रीन के ऊपर दिखता है।";
"faq.pinchOverlaySize" = "सेगमेंट किए फर्नीचर को पिंच करने पर क्या होता है?";
"faq.pinchOverlaySizeAnswer" = "पिंच करने पर फर्नीचर ओवरले बड़ा या छोटा होता है। साइजिंग मोड चालू और Furni पिल दिखाई देने पर वह रूम के लिए बदले हुए फर्नीचर आकार के मौजूदा अनुमान से अपडेट होती है। साइजिंग मोड बंद हो तो पिंच केवल स्क्रीन पर ओवरले का दृश्य आकार बदलता है।";

