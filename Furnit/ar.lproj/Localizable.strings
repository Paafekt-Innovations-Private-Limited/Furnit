// FAQ - Room Creation
"faq.roomCreation" = "إنشاء الغرفة";
"faq.howToCreate" = "كيف أنشئ غرفة ثلاثية الأبعاد؟";
"faq.howToCreateAnswer" = "Tap Photo → 3D on the home screen toolbar (or Create Room from Photo in the empty state), then take or select a photo of your room. You'll see two options for creating your 3D room.";
"faq.howToTakePhoto" = "كيف ألتقط صورة لإنشاء غرفة؟";
"faq.howToTakePhotoAnswer" = "When creating a room, choose Take a Photo. You can pick Standard (1x) or Wide Angle (0.5× ultra-wide). Hold your device steady and tap capture. The photo is then used to build your 3D room.";
"faq.depthAwareRoomPhoto" = "هل يساعد التقاط الصورة داخل التطبيق على جودة الغرفة؟";
"faq.depthAwareRoomPhotoAnswer" = "نعم. على الأجهزة المدعومة، خيار «التقاط صورة» بدلاً من المعرض يستخدم كاميرا التطبيق مع العمق عند توفره، مما قد يحسن بناء الغرفة ثلاثية الأبعاد وحجمها.";
"faq.twoMethods" = "ما خيارا إنشاء الغرفة المتاحان؟";
"faq.twoMethodsAnswer" = "عند اختيار صورة يمكنك الاختيار بين: 1) غرفة 3D بالذكاء الاصطناعي – تنشئ تلقائياً غرفة 3D واقعية، أو 2) الإعداد اليدوي – ترسم حدود الغرفة بنفسك لمزيد من التحكم.";
"faq.whatIsAIRoom" = "ما هي الغرفة ثلاثية الأبعاد بالذكاء الاصطناعي؟";
"faq.whatIsAIRoomAnswer" = "AI Room uses GeoCalib for camera calibration and Depth Anything for metric depth to build a textured 3D room from your photo. Pick a photo and the app handles the rest; no drawing required.";
"faq.whatIsManualRoom" = "ما هو الإعداد اليدوي؟";
"faq.whatIsManualRoomAnswer" = "في الإعداد اليدوي ترسم حدود جدران غرفتك على الصورة. يعطيك تحكماً أدق في مظهر الغرفة 3D. مثالي عندما تريد ضبط شكل الغرفة بنفسك.";
"faq.whichMethodBetter" = "أي طريقة يجب أن أختار؟";
"faq.whichMethodBetterAnswer" = "جرب أولاً بالذكاء الاصطناعي – أسرع ويناسب معظم الغرف. إن لم يعجبك الناتج، استخدم الإعداد اليدوي لرسم الجدران حيث تريد. يمكنك تجربة الاثنتين!";
"faq.bestPhotos" = "ما نوع الصور التي تعمل بشكل أفضل؟";
"faq.bestPhotosAnswer" = "للحصول على أفضل النتائج، التقط الصور في إضاءة جيدة مع إمساك الجهاز بثبات. حاول التقاط الغرفة بالكامل بما في ذلك الأرضيات والجدران وحواف السقف. تجنب الصور الضبابية أو المظلمة.";
"faq.generationFailing" = "لماذا يفشل إنشاء غرفتي؟";
"faq.generationFailingAnswer" = "قد يفشل إنشاء الغرفة إذا كانت الصورة مظلمة جداً أو ضبابية أو لا تُظهر ميزات كافية للغرفة. جرب التقاط صورة جديدة بإضاءة أفضل وزاوية أوسع.";
"faq.howManyRooms" = "كم عدد الغرف التي يمكنني إنشاؤها؟";
"faq.howManyRoomsAnswer" = "يمكنك إنشاء ما يصل إلى 20 غرفة. احذف الغرف القديمة لإفساح المجال للجديدة. يُعرض عدد الغرف والتخزين المستخدم في أعلى الشاشة الرئيسية.";

// FAQ - AI Features
"faq.aiFeatures" = "ميزات الذكاء الاصطناعي";
"faq.whatIsBrainIcon" = "What does the Fit button do?";
"faq.whatIsBrainIconAnswer" = "Tap the gold Fit button (bottom-right) in the room viewer to start SmartyPants furniture segmentation. By default it auto-segments the highest-confidence item as a transparent cutout over your 3D room. Tap Done (top-right) to exit. For tap-to-select specific pieces, summon controls and enable full-video mode first.";
"faq.whatIsViewfinderButton" = "What does full-video mode do in the room viewer?";
"faq.whatIsViewfinderButtonAnswer" = "While Fit is active, summon controls and tap the viewfinder icon to toggle full-video mode. You get a live camera feed with detection boxes—tap one or more items, then tap Segment. The camera hides and transparent cutouts composite over your 3D room. Tap Done (top-right) to exit segment mode or leave Fit entirely.";
"faq.howToScreenshot" = "كيف ألتقط لقطة شاشة؟";
"faq.howToScreenshotAnswer" = "Tap the room to summon controls, then tap Capture. This saves the current view (including furniture overlays when Fit is on) to your Photos library.";
"faq.howToSaveRoom" = "كيف أحفظ غرفة؟";
"faq.howToSaveRoomAnswer" = "After generating a 3D room, tap the room to summon controls, then tap the save icon (download arrow) and enter a name. If you leave a preview without saving, that room is discarded.";

// FAQ - Furniture Segmentation
"faq.furnitureSegmentation" = "تجزئة الأثاث";
"faq.whatIsSegmentation" = "ما هي تجزئة الأثاث؟";
"faq.whatIsSegmentationAnswer" = "Furniture segmentation runs from the room viewer via the Fit button. By default one primary item is auto-segmented. In full-video mode, select detected items first; Segment then creates transparent cutouts only for those pieces.";
"faq.howToSegment" = "كيف أجزّئ الأثاث في عارض الغرفة؟";
"faq.howToSegmentAnswer" = "Tap Fit in the room viewer. For a quick check it auto-segments the main item. To pick specific pieces: summon controls, enable full-video mode, point the camera at the furniture, tap detection boxes, then tap Segment. Tap Done (top-right) to exit.";
"faq.notDetected" = "لماذا لم يتم اكتشاف أثاثي؟";
"faq.notDetectedAnswer" = "يعمل اكتشاف الأثاث بشكل أفضل مع الصور الواضحة والمضاءة جيداً حيث يكون الأثاث مرئياً بوضوح. تأكد من أن الأثاث غير مخفي جزئياً أو متمازج مع الخلفية.";
"faq.multiplePieces" = "هل يمكنني تجزئة قطع أثاث متعددة؟";
"faq.multiplePiecesAnswer" = "Yes! In full-video mode you can tap several detection boxes, then tap Segment once to cut out all selected pieces together over your 3D room. You can also segment items one at a time using the default Fit flow.";

// FAQ - 3D Room Controls
"faq.roomControls" = "التحكم بالغرفة ثلاثية الأبعاد";
"faq.howToNavigate" = "كيف أتنقل داخل الغرفة؟";
"faq.howToNavigateAnswer" = "Drag on the room to orbit the camera and pinch to zoom. Tap the screen to summon the toolbar, then use the viewfinder icon to recenter. A quiet summon disk at bottom-left also brings controls back when hidden.";
"faq.whatDoArrowsDo" = "How do I show or hide viewer controls?";
"faq.whatDoArrowsDoAnswer" = "The room viewer uses immersive mode—controls hide for a clean view. Tap the room to summon the toolbar. The gold Fit button at bottom-right is always visible. While Fit is active, Done appears top-right to exit segmentation.";
"faq.whatIsMemoryDisplay" = "ماذا يعني رقم MB؟";
"faq.whatIsMemoryDisplayAnswer" = "يشير MB (ميجابايت) المعروض في الغرف إلى حجم الملف. يساعدك هذا على إدارة التخزين. يُعرض إجمالي التخزين المستخدم في أعلى الشاشة الرئيسية.";

// FAQ - 3D Room & Fitment
"faq.howToView" = "كيف أعرض غرفتي ثلاثية الأبعاد؟";
"faq.howToViewAnswer" = "Tap any room on the home screen to open the 3D viewer. Drag to look around and pinch to zoom. Tap the room to summon extra controls (recenter, ruler, Capture). The gold Fit button stays visible at bottom-right.";
"faq.howToPlace" = "كيف أضع الأثاث في غرفتي؟";
"faq.howToPlaceAnswer" = "بعد الضغط على Segment، يظهر الأثاث المحدد كطبقة فوق الغرفة. اسحبه لتحديد الموضع، واقرص لتغيير الحجم، ودوّره لضبط الاتجاه.";
"faq.sampleRoom" = "هل يمكنني استخدام غرفة نموذجية بدلاً من غرفتي؟";
"faq.sampleRoomAnswer" = "نعم! يوفر التطبيق غرف نموذجية للتجربة. يمكنك الوصول إليها من قسم الاستكشاف لتجربة وضع الأثاث دون إنشاء غرفتك الخاصة أولاً.";
"faq.accuracy" = "ما مدى دقة النموذج ثلاثي الأبعاد؟";
"faq.accuracyAnswer" = "The 3D room is estimated from one photo using camera calibration and metric depth. Dimensions are useful as guidance, not tape-measure accurate. Furniture sizing is most reliable on phones with AR/depth support.";
"faq.adjustDimensions" = "هل يمكنني ضبط أبعاد الغرفة؟";
"faq.adjustDimensionsAnswer" = "You cannot edit AI room dimensions manually. After saving, summon controls and tap the ruler to see estimated width, height, and depth. During the pre-save preview, dimension chips are hidden—save the room first, then reopen to see measurements. Manual rooms follow the boundaries you draw.";
"faq.furnitureMeasurements" = "الأثاث والقياسات";
"faq.arAssistedSizing" = "ما هو تحديد حجم الأثاث بمساعدة الواقع المعزز؟";
"faq.arAssistedSizingAnswer" = "Tap Fit to segment furniture first. Use the sizing control in the summoned toolbar when you want room-relative scale. On phones with AR/depth support, the app uses live camera depth; without depth, furniture measurements are approximate.";
"faq.measurementPill" = "ما هي القراءة الصغيرة للقياسات؟";
"faq.measurementPillAnswer" = "عندما يكون SmartyPants نشطاً، قد تظهر تقديرات لارتفاع الأثاث والغرفة. اضغط لإدخال قياسات فعلية لدقة أفضل. إذا كانت صورة الغرفة بالزاوية الواسعة (0.5×)، حدد ذلك.";
"faq.resetOverlayScale" = "تبدو القناع مكبراً بشكل خاطئ—ماذا أفعل؟";
"faq.resetOverlayScaleAnswer" = "There is no overflow menu now. If the overlay looks off, tap Done to exit Fit and tap Fit again, or pinch the furniture manually to fine-tune its size.";
"faq.roomFitment" = "كيف أتحقق من ملاءمة الأثاث؟";
"faq.roomFitmentAnswer" = "بعد التجزئة، غيّر حجم موضع القصاصات في غرفتك ثلاثية الأبعاد. في وضع الفيديو الكامل، يضع Segment القطع المحددة فوق الغرفة لمقارنة عدة عناصر مع المساحة.";

// FAQ - Placement intelligence & aesthetic
"faq.placementIntelligence" = "ذكاء الموضع والجمالية";
"faq.whatIsPlacementIntelligence" = "ما هو «ذكاء الموضع» (Placement Intelligence)؟";
"faq.whatIsPlacementIntelligenceAnswer" = "While Fit is active in supported 3D room viewers, a Placement Intelligence card shows whether the detected furniture fits within the room dimensions. Tap the header to expand full details, or leave it collapsed to save space.";
"faq.furnitureColorAesthetic" = "كيف تختار التطبيق لونًا لدرجة الجمالية";
"faq.furnitureColorAestheticAnswer" = "يحسب التطبيق متوسط RGB للبكسلات المرئية داخل قص الذكاء الاصطناعي للأثاث (نفس طبقة التجزئة التي تراها). يُقارَن هذا اللون المتوسط بألوان مأخوذة عينة من الأرضية والجدران والسقف. إذا لم يكن القص جاهزًا بعد، يُستخدم لون احتياطي من لوحة الغرفة حتى توفر التجزئة عينة حقيقية.";
"faq.whatDoHarmonyContrastMean" = "ماذا تعني الانسجام والتباين وملاءمة الأسلوب؟";
"faq.whatDoHarmonyContrastMeanAnswer" = "هذه قواعد تصميم بسيطة وليست حكمًا ذوقيًا. يصف الانسجام علاقة لون الأثاث بلوحة الغرفة (مثل ألوان قريبة أو مكمّلة). يقيس التباين اختلاف السطوع عن ألوان أرضية أو جدران نموذجية. تقارن ملاءمة الأسلوب وسوم أسلوب واسعة مُستنتجة للغرفة مع ملف حديث افتراضي، لذا هي تقريبية.";
"faq.whenDoesAestheticScoreLow" = "متى قد تبدو درجات الجمالية منخفضة أو تظهر «clash»؟";
"faq.whenDoesAestheticScoreLowAnswer" = "الأشياء الزاهية والشديدة التشبغ غالبًا تحصل على درجة أقل إذا لم يتوافق لونها مع أنماط الانسجام في التطبيق مقارنة بغرفتك—مثل أخضر حامضي أو أرجواني أو بنفسجي أو برتقالي سلامة في غرف دافئة بيج أو بنية، أو ألوان أولية صارخة عندما تكون عينات الغرفة أحادية تقريبًا. تشابه كبير في السطوع مع الأرضية أو الجدار (بني على بني، رمادي على رمادي) قد يخفض التباين حتى لو أعجبك المظهر. الغرف المُستنتَج أسلوبها ريفي أو تقليدي قد تظهر ملاءمة أسلوب أقل لأن ملف الأثاث يستخدم وسومًا حديثة/بسيطة افتراضيًا. متوسطات رمادية باهتة من خلفيات مزدحمة قد تُصنَّف «محايدة» بدل التضارب. تعامل الدرجات كإرشاد فقط وثق بعينك في الديكور الفعلي.";

