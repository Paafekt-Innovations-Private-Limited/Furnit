#usda 1.0
(
    defaultPrim = "Room"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "Room" {
    def Scope "Looks" {
    def Material "wall" {
        token outputs:surface.connect = </Room/Looks/wall/PreviewSurface.outputs:surface>
        def Shader "PreviewSurface" {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor.connect = </Room/Looks/wall/DiffuseTexture.outputs:rgb>
            float inputs:metallic = 0
            float inputs:roughness = 0.72
            token outputs:surface
        }
        def Shader "PrimvarReader_st" {
            uniform token info:id = "UsdPrimvarReader_float2"
            token inputs:varname = "st"
            float2 outputs:result
        }
        def Shader "DiffuseTexture" {
            uniform token info:id = "UsdUVTexture"
            asset inputs:file = @textures/scandi_plaster.png@
            token inputs:wrapS = "repeat"
            token inputs:wrapT = "repeat"
            float2 inputs:st.connect = </Room/Looks/wall/PrimvarReader_st.outputs:result>
            color3f outputs:rgb
        }
    }
    def Material "floor" {
        token outputs:surface.connect = </Room/Looks/floor/PreviewSurface.outputs:surface>
        def Shader "PreviewSurface" {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor.connect = </Room/Looks/floor/DiffuseTexture.outputs:rgb>
            float inputs:metallic = 0
            float inputs:roughness = 0.62
            token outputs:surface
        }
        def Shader "PrimvarReader_st" {
            uniform token info:id = "UsdPrimvarReader_float2"
            token inputs:varname = "st"
            float2 outputs:result
        }
        def Shader "DiffuseTexture" {
            uniform token info:id = "UsdUVTexture"
            asset inputs:file = @textures/scandi_light_oak.png@
            token inputs:wrapS = "repeat"
            token inputs:wrapT = "repeat"
            float2 inputs:st.connect = </Room/Looks/floor/PrimvarReader_st.outputs:result>
            color3f outputs:rgb
        }
    }
    def Material "ceiling" {
        token outputs:surface.connect = </Room/Looks/ceiling/PreviewSurface.outputs:surface>
        def Shader "PreviewSurface" {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor.connect = </Room/Looks/ceiling/DiffuseTexture.outputs:rgb>
            float inputs:metallic = 0
            float inputs:roughness = 0.76
            token outputs:surface
        }
        def Shader "PrimvarReader_st" {
            uniform token info:id = "UsdPrimvarReader_float2"
            token inputs:varname = "st"
            float2 outputs:result
        }
        def Shader "DiffuseTexture" {
            uniform token info:id = "UsdUVTexture"
            asset inputs:file = @textures/scandi_plaster.png@
            token inputs:wrapS = "repeat"
            token inputs:wrapT = "repeat"
            float2 inputs:st.connect = </Room/Looks/ceiling/PrimvarReader_st.outputs:result>
            color3f outputs:rgb
        }
    }
    def Material "trim" {
        token outputs:surface.connect = </Room/Looks/trim/PreviewSurface.outputs:surface>
        def Shader "PreviewSurface" {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.96, 0.95, 0.92)
            float inputs:metallic = 0
            float inputs:roughness = 0.58
            token outputs:surface
        }
    }
    def Material "white_frame" {
        token outputs:surface.connect = </Room/Looks/white_frame/PreviewSurface.outputs:surface>
        def Shader "PreviewSurface" {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.96, 0.95, 0.92)
            float inputs:metallic = 0
            float inputs:roughness = 0.45
            token outputs:surface
        }
    }
    def Material "soft_glass" {
        token outputs:surface.connect = </Room/Looks/soft_glass/PreviewSurface.outputs:surface>
