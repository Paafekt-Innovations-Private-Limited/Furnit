"faq.troubleshootingSupport" = "Solución de problemas y soporte";
"faq.uninstallRooms" = "¿Qué pasa con mis cuartos si desinstalo Paafekt?";
"faq.uninstallRoomsAnswer" = "Al desinstalar Paafekt, los cuartos de su almacenamiento privado se eliminan de forma permanente. Comparte todo lo que quieras conservar antes de desinstalar la app.";
"faq.exportRoom" = "¿Cómo hago un respaldo o exporto un cuarto?";
"faq.exportRoomAnswer" = "Usa Compartir cuando esté disponible para ese tipo de cuarto. Capturar comparte una imagen de la vista actual, no un respaldo del cuarto que pueda restaurarse. Actualmente, Paafekt no ofrece sincronización en la nube ni garantiza un respaldo de toda la biblioteca.";
"faq.freeFloorLocation" = "¿Placement Intelligence encuentra un lugar disponible en el piso?";
"faq.freeFloorLocationAnswer" = "No. Comprueba si las dimensiones estimadas del mueble son compatibles con el volumen del cuarto. No detecta espacio libre en el piso ni identifica un lugar específico disponible.";
"faq.dimensionalFit" = "¿Cómo se calcula el ajuste dimensional?";
"faq.dimensionalFitAnswer" = "El ancho y la altura estimados del objeto, además de su profundidad calculada, se comparan con las dimensiones estimadas del cuarto, incluida una huella girada cuando resulta útil. Como ambos conjuntos de dimensiones son estimaciones, considera el resultado solo como una guía.";
"faq.aestheticScore" = "¿Cómo se calcula la puntuación estética?";
"faq.aestheticScoreAnswer" = "La app compara el color visible promedio del mueble segmentado con colores muestreados del cuarto. La armonía, el contraste de luminosidad y la compatibilidad general de estilo contribuyen a la puntuación. Son heurísticas de diseño aproximadas, no reglas sobre el gusto.";
"faq.aestheticUnavailable" = "¿Por qué no está disponible la orientación estética?";
"faq.aestheticUnavailableAnswer" = "La orientación estética necesita muestras de color válidas tanto del cuarto como del mueble segmentado. Si alguna no está disponible, Paafekt no muestra ninguna puntuación en vez de inventarla.";
"faq.purchaseReliance" = "¿Puedo confiar en Paafekt al comprar muebles?";
"faq.purchaseRelianceAnswer" = "Usa Paafekt como guía, no como garantía. Antes de comprar, confirma siempre con el vendedor las dimensiones, los espacios libres necesarios y la idoneidad del mueble.";
"faq.deleteAccountEffect" = "¿Qué pasa cuando elimino mi cuenta?";
"faq.deleteAccountEffectAnswer" = "Al eliminar tu cuenta, se borra la cuenta de autenticación de Firebase y se cierra tu sesión. Los cuartos guardados en este dispositivo no se eliminan automáticamente; elimínalos en Paafekt o desinstala la app para borrarlos.";
"faq.firebaseData" = "¿Qué datos procesa Firebase?";
"faq.firebaseDataAnswer" = "Firebase procesa tu número de teléfono, los registros de autenticación y un identificador de instalación del dispositivo utilizado para la verificación y la prevención de abusos. La creación de cuartos y el procesamiento de muebles permanecen en este dispositivo.";
"faq.contactSupport" = "¿Cómo contacto a soporte?";
"faq.contactSupportAnswer" = "Abre Configuración → Ayuda y soporte y escribe a support@paafekt.com.";

