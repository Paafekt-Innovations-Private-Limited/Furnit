#usda 1.0
(
    defaultPrim = "Room"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "Room" {
    def Scope "Looks" {
    def Material "concrete_wall" {
        token outputs:surface.connect = </Room/Looks/concrete_wall/PreviewSurface.outputs:surface>
        def Shader "PreviewSurface" {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor.connect = </Room/Looks/concrete_wall/DiffuseTexture.outputs:rgb>
            float inputs:metallic = 0
            float inputs:roughness = 0.78
            token outputs:surface
        }
        def Shader "PrimvarReader_st" {
            uniform token info:id = "UsdPrimvarReader_float2"
            token inputs:varname = "st"
            float2 outputs:result
        }
        def Shader "DiffuseTexture" {
            uniform token info:id = "UsdUVTexture"
            asset inputs:file = @textures/loft_concrete.png@
            token inputs:wrapS = "repeat"
            token inputs:wrapT = "repeat"
            float2 inputs:st.connect = </Room/Looks/concrete_wall/PrimvarReader_st.outputs:result>
            color3f outputs:rgb
        }
    }
    def Material "brick_wall" {
        token outputs:surface.connect = </Room/Looks/brick_wall/PreviewSurface.outputs:surface>
        def Shader "PreviewSurface" {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor.connect = </Room/Looks/brick_wall/DiffuseTexture.outputs:rgb>
            float inputs:metallic = 0
            float inputs:roughness = 0.82
            token outputs:surface
        }
        def Shader "PrimvarReader_st" {
            uniform token info:id = "UsdPrimvarReader_float2"
            token inputs:varname = "st"
            float2 outputs:result
        }
        def Shader "DiffuseTexture" {
            uniform token info:id = "UsdUVTexture"
            asset inputs:file = @textures/loft_brick.png@
            token inputs:wrapS = "repeat"
            token inputs:wrapT = "repeat"
            float2 inputs:st.connect = </Room/Looks/brick_wall/PrimvarReader_st.outputs:result>
            color3f outputs:rgb
        }
    }
    def Material "floor" {
        token outputs:surface.connect = </Room/Looks/floor/PreviewSurface.outputs:surface>
