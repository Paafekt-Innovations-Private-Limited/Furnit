"faq.troubleshootingSupport" = "சிக்கல் தீர்வு மற்றும் ஆதரவு";
"faq.uninstallRooms" = "Paafekt-ஐ நிறுவல் நீக்கினால் என் அறைகளுக்கு என்ன ஆகும்?";
"faq.uninstallRoomsAnswer" = "Paafekt-ஐ நிறுவல் நீக்கினால் அதன் தனிப்பட்ட பயன்பாட்டுச் சேமிப்பக அறைகள் நிரந்தரமாக அழியும். வைத்திருக்க வேண்டியவற்றை முன்பே பகிரவும்.";
"faq.exportRoom" = "அறையை காப்புப்பிரதி எடுப்பது அல்லது ஏற்றுமதி செய்வது எப்படி?";
"faq.exportRoomAnswer" = "அந்த அறை வகைக்கு Share கிடைக்கும்போது பயன்படுத்தவும். Capture தற்போதைய காட்சிப் படத்தைப் பகிரும்; மீட்டெடுக்கக்கூடிய அறைக் காப்புப்பிரதி அல்ல. Paafekt தற்போது மேக ஒத்திசைவு அல்லது முழு நூலகக் காப்புப்பிரதி உறுதி வழங்காது.";
"faq.freeFloorLocation" = "Placement Intelligence தரையில் காலியிடத்தைக் கண்டுபிடிக்குமா?";
"faq.freeFloorLocationAnswer" = "இல்லை. மதிப்பிட்ட மரச்சாமான் அளவுகள் அறை எல்லைக்குப் பொருந்துமா என்பதை மட்டும் பார்க்கும். காலியான தரையையோ குறிப்பிட்ட திறந்த இடத்தையோ கண்டறியாது.";
"faq.dimensionalFit" = "அளவியல் பொருத்தம் எப்படிக் கணக்கிடப்படுகிறது?";
"faq.dimensionalFitAnswer" = "பொருளின் மதிப்பிட்ட அகலம், உயரம், கணிக்கப்பட்ட ஆழம் அறையின் மதிப்பிட்ட அளவுகளுடன் ஒப்பிடப்படும்; உதவுமானால் சுழற்றிய அடித்தளமும் கணக்கில் கொள்ளப்படும். இரண்டும் கணிப்புகள் என்பதால் வழிகாட்டலாக மட்டும் கொள்ளவும்.";
"faq.aestheticScore" = "அழகியல் மதிப்பெண் எப்படிக் கணக்கிடப்படுகிறது?";
"faq.aestheticScoreAnswer" = "பிரித்த மரச்சாமானின் சராசரி தெரியும் நிறத்தை அறையிலிருந்து எடுத்த நிறங்களுடன் பயன்பாடு ஒப்பிடுகிறது. நிற இசைவு, ஒளிர்வு வேறுபாடு, பொதுப் பாணிப் பொருத்தம் ஆகியவை மதிப்பெண்ணில் பங்களிக்கின்றன. இவை தோராயமான வடிவமைப்பு வழிகாட்டல்கள்.";
"faq.aestheticUnavailable" = "அழகியல் வழிகாட்டல் ஏன் கிடைக்கவில்லை?";
"faq.aestheticUnavailableAnswer" = "அறையிலும் பிரித்த மரச்சாமானிலும் பயன்படுத்தக்கூடிய நிற மாதிரிகள் தேவை. ஒன்று கிடைக்காவிட்டால் Paafekt கற்பனை மதிப்பெண்ணைக் காட்டாது.";
"faq.purchaseReliance" = "மரச்சாமான் வாங்கும்போது Paafekt-ஐ நம்பலாமா?";
"faq.purchaseRelianceAnswer" = "Paafekt-ஐ வழிகாட்டலாகப் பயன்படுத்துங்கள்; உத்தரவாதமாக அல்ல. வாங்குமுன் அளவுகள், இடைவெளி, பொருத்தம் ஆகியவற்றை விற்பனையாளரிடம் உறுதிப்படுத்தவும்.";
"faq.deleteAccountEffect" = "என் கணக்கை நீக்கினால் என்ன ஆகும்?";
"faq.deleteAccountEffectAnswer" = "கணக்கை நீக்குவது Firebase அங்கீகாரக் கணக்கை அகற்றி உங்களை வெளியேற்றும். இந்தச் சாதனத்தில் சேமித்த அறைகள் தானாக நீங்காது; Paafekt-இல் நீக்கவும் அல்லது பயன்பாட்டை நிறுவல் நீக்கவும்.";
"faq.firebaseData" = "Firebase எந்தத் தரவைச் செயலாக்குகிறது?";
"faq.firebaseDataAnswer" = "Firebase உங்கள் தொலைபேசி எண், அங்கீகாரப் பதிவுகள், சரிபார்ப்பு மற்றும் முறைகேடு தடுப்புக்கான சாதன நிறுவல் அடையாளம் ஆகியவற்றைச் செயலாக்குகிறது. அறை உருவாக்கமும் மரச்சாமான் செயலாக்கமும் இந்தச் சாதனத்தில் நடக்கும்.";
"faq.contactSupport" = "ஆதரவை எப்படித் தொடர்புகொள்வது?";
"faq.contactSupportAnswer" = "அமைப்புகள் → உதவி & ஆதரவு திறந்து support@paafekt.com-க்கு மின்னஞ்சல் அனுப்பவும்.";
