"faq.bestPhotosAnswer" = "সেরা ফলাফলের জন্য ভালো আলোতে ক্যামেরা সমতল রেখে ছবি তুলুন। মেঝে, দেয়াল ও ছাদের প্রান্তসহ পুরো রুম ধরার চেষ্টা করুন। ঝাপসা বা অন্ধকার ছবি এড়িয়ে চলুন।";
"faq.howManyRooms" = "আমি কতটি রুম তৈরি করতে পারি?";
"faq.howManyRoomsAnswer" = "আপনি সর্বোচ্চ ২০টি রুম সেভ করতে পারেন। জায়গা খালি করতে অপ্রয়োজনীয় রুম মুছুন। রুম লাইব্রেরিতে বর্তমান রুমের সংখ্যা ও মোট ব্যবহৃত স্টোরেজ দেখা যায়।";
"faq.howToView" = "আমি আমার 3D রুম কীভাবে দেখব?";
"faq.howToViewAnswer" = "3D ভিউয়ার খুলতে হোম স্ক্রিনে যেকোনো রুম ট্যাপ করুন। চারপাশ দেখতে টানুন এবং জুম করতে পিঞ্চ করুন। অতিরিক্ত নিয়ন্ত্রণ (রিসেন্টার, রুলার, Capture) আনতে রুমে ট্যাপ করুন। নিচে ডানদিকে সোনালি Fit বাটনটি সবসময় দেখা যায়।";
"faq.howToNavigate" = "আমি রুমের ভেতরে কীভাবে নেভিগেট করব?";
"faq.howToNavigateAnswer" = "ক্যামেরা ঘোরাতে রুমে টানুন এবং জুম করতে পিঞ্চ করুন। টুলবার আনতে স্ক্রিনে ট্যাপ করে ডিফল্ট দৃশ্য ফেরাতে রিসেন্টার ট্যাপ করুন। নিয়ন্ত্রণ লুকানো থাকলে নিচে বাঁদিকে ছোট নিয়ন্ত্রণটিও টুলবার ফিরিয়ে আনে।";
"faq.aiRoomManualSetup" = "AI Room ও ম্যানুয়াল সেটআপ";
"faq.twoMethods" = "AI Room ও ম্যানুয়াল সেটআপের মধ্যে পার্থক্য কী?";
"faq.twoMethodsAnswer" = "AI Room একটি ছবি থেকে রুমের মাত্রা অনুমান করে এবং একটি পরিমাপযুক্ত, টেক্সচারযুক্ত উপস্থাপনা তৈরি করে। এটি পূর্ণ ভলিউমেট্রিক পুনর্গঠন নয়। ম্যানুয়াল সেটআপে আরও নিয়ন্ত্রিত উপস্থাপনার জন্য নিজে রুমের সীমানা নির্ধারণ করা যায়।";
"faq.whatIsAIRoom" = "AI-চালিত 3D রুম কী?";
"faq.whatIsAIRoomAnswer" = "AI Room ডিভাইসের গভীরতা অনুমান, ফার্নিচার অ্যাঙ্কর ও ক্যামেরা ক্যালিব্রেশন ব্যবহার করে একটি ছবি থেকে পরিমাপযুক্ত, টেক্সচারযুক্ত রুম অনুমান করে। এটি পূর্ণ ভলিউমেট্রিক পুনর্গঠন নয়।";
"faq.whatIsManualRoom" = "ম্যানুয়াল সেটআপ কী?";
"faq.whatIsManualRoomAnswer" = "ম্যানুয়াল সেটআপে ফলাফলের ওপর বেশি নিয়ন্ত্রণের জন্য ছবিতেই রুমের সীমানা সরাসরি নির্ধারণ করা যায়।";
"faq.whichMethodBetter" = "আমার কোন পদ্ধতি বেছে নেওয়া উচিত?";
"faq.whichMethodBetterAnswer" = "দ্রুত স্বয়ংক্রিয় অনুমানের জন্য AI Room বেছে নিন। রুমের সীমানার ওপর সরাসরি নিয়ন্ত্রণ চাইলে ম্যানুয়াল সেটআপ নিন। একটি ফল উপযুক্ত না হলে অন্যটি চেষ্টা করুন।";
"faq.depthAwareRoomPhoto" = "অ্যাপের মধ্যে ছবি তুললে কি রুমের মান উন্নত হয়?";
"faq.depthAwareRoomPhotoAnswer" = "হ্যাঁ। সমর্থিত ডিভাইসে গ্যালারি থেকে বেছে নেওয়ার বদলে ছবি তুলুন নির্বাচন করলে উপলভ্য ক্ষেত্রে গভীরতাসহ ইন-অ্যাপ ক্যামেরা ব্যবহৃত হয়, যা 3D রুমের নির্মাণ ও স্কেল উন্নত করতে পারে।";
"faq.aiFeatures" = "ফার্নিচার শনাক্তকরণ ও আকার নির্ধারণ";
"faq.whatIsBrainIcon" = "Fit বাটন কী করে?";
"faq.whatIsBrainIconAnswer" = "একটি ফার্নিচার শনাক্ত করে 3D রুমের ওপর স্বচ্ছ কাটআউট তৈরি করতে Fit ট্যাপ করুন। কাটআউটটির অবস্থান ঠিক করতে টানুন এবং আকার বদলাতে পিঞ্চ করুন। Fit একটি ভিজ্যুয়াল প্রিভিউ; পরিমাপভিত্তিক নির্দেশনার জন্য AR-সহায়িত সাইজিং প্রয়োজন।";
"faq.whatIsViewfinderButton" = "রুম ভিউয়ারে পূর্ণ-ভিডিও মোড কী করে?";
"faq.whatIsViewfinderButtonAnswer" = "Fit চালু থাকা অবস্থায় নিয়ন্ত্রণ আনুন এবং পূর্ণ-ভিডিও মোড টগল করতে ভিউফাইন্ডার আইকন ট্যাপ করুন। শনাক্তকরণ বক্সসহ লাইভ ক্যামেরা ফিডে এক বা একাধিক আইটেম ট্যাপ করে Segment চাপুন। ক্যামেরা লুকিয়ে স্বচ্ছ কাটআউটগুলো 3D রুমের ওপর বসে। বের হতে ওপরের ডানদিকে সম্পন্ন ট্যাপ করুন।";
"faq.whatIsSegmentation" = "ফার্নিচার সেগমেন্টেশন কী?";
"faq.whatIsSegmentationAnswer" = "ফার্নিচার সেগমেন্টেশন ক্যামেরা দৃশ্যে একটি আইটেম শনাক্ত করে এবং দৃশ্যমান পিক্সেলগুলো পটভূমি থেকে আলাদা করে, যাতে সেটি সরানো যায় এমন কাটআউট হিসেবে দেখা যায়। প্রসেসিং এই ডিভাইসেই হয়।";
"faq.howToSegment" = "রুম ভিউয়ারে ফার্নিচার কীভাবে সেগমেন্ট করব?";
"faq.howToSegmentAnswer" = "রুম ভিউয়ারে Fit ট্যাপ করুন। দ্রুত যাচাইয়ে প্রধান আইটেমটি স্বয়ংক্রিয়ভাবে সেগমেন্ট হয়। নির্দিষ্ট আইটেম বাছতে নিয়ন্ত্রণ আনুন, পূর্ণ-ভিডিও মোড চালু করুন, ক্যামেরা ফার্নিচারের দিকে ধরুন, শনাক্তকরণ বক্স ট্যাপ করে Segment চাপুন। বের হতে ওপরের ডানদিকে সম্পন্ন ট্যাপ করুন।";
"faq.arAssistedSizing" = "AR-সহায়িত সাইজিং কী?";
"faq.arAssistedSizingAnswer" = "AR-সহায়িত সাইজিং সমর্থিত ক্যামেরা ও গভীরতার সুবিধা ব্যবহার করে ফার্নিচারের মাত্রা অনুমান করে। ফলাফল ক্যাপচারের মান ও ট্র্যাকিং পরিস্থিতির ওপর নির্ভরশীল এবং অনুমান হিসেবেই থাকে।";
"faq.measurementPill" = "ছোট মাপের রিডআউটটি কী?";
"faq.measurementPillAnswer" = "সাইজিং মোড চালু এবং ব্যবহারযোগ্য লাইভ উচ্চতার অনুমান থাকলেই ফার্নিচার সাইজ পিল দেখা যায়। রুলার বাটন একটি ছোট কার্ডে রুমের বর্তমান প্রস্থ, উচ্চতা ও গভীরতা দেখায়। AR-বিহীন ফোনে, বিশেষ করে ফার্নিচারের ক্ষেত্রে, এসব রিডিং কম নির্ভরযোগ্য।";
"faq.resetOverlayScale" = "ফার্নিচার মাস্ক ভুলভাবে জুম করা দেখাচ্ছে—কী করব?";
"faq.resetOverlayScaleAnswer" = "এখন কোনো ওভারফ্লো মেনু নেই। ওভারলে ভুল দেখালে সম্পন্ন ট্যাপ করে Fit থেকে বের হয়ে আবার Fit ট্যাপ করুন, অথবা পিঞ্চ করে ফার্নিচারের আকার সূক্ষ্মভাবে ঠিক করুন।";
"faq.pinchOverlaySize" = "সেগমেন্ট করা ফার্নিচার পিঞ্চ করলে কী হয়?";
"faq.pinchOverlaySizeAnswer" = "পিঞ্চ করলে ফার্নিচার ওভারলে বড় বা ছোট হয়। সাইজিং মোড চালু এবং Furni পিল দৃশ্যমান থাকলে সেটি রুম অনুযায়ী বর্তমান পরিবর্তিত ফার্নিচার অনুমানে আপডেট হয়। সাইজিং মোড বন্ধ থাকলে পিঞ্চ শুধু স্ক্রিনে ওভারলের দৃশ্যমান আকার বদলায়।";
"faq.howToPlace" = "আমি আমার রুমে ফার্নিচার কীভাবে রাখব?";
"faq.howToPlaceAnswer" = "Segment ট্যাপ করার পর নির্বাচিত ফার্নিচার রুমে ওভারলে হিসেবে দেখা যায়। অবস্থান ঠিক করতে টানুন এবং আকার বদলাতে পিঞ্চ করুন।";
"faq.multiplePieces" = "আমি কি একাধিক ফার্নিচার যোগ করতে পারি?";
"faq.multiplePiecesAnswer" = "পূর্ণ-ভিডিও মোডে একাধিক শনাক্তকরণ বক্স বেছে নিয়ে Segment ট্যাপ করলে কাটআউটগুলো একসঙ্গে তৈরি হয়। ডিফল্ট Fit প্রবাহে একবারে একটি আইটেমও সেগমেন্ট করতে পারেন।";
"faq.placementIntelligence" = "Placement Intelligence";
"faq.whatIsPlacementIntelligence" = "Placement Intelligence কী?";
"faq.whatIsPlacementIntelligenceAnswer" = "Placement Intelligence কোনো আইটেমের আনুমানিক প্রস্থ, উচ্চতা ও নির্ণীত গভীরতা রুমের পরিসরের সঙ্গে তুলনা করে। এটি শুধু মাত্রাগত সামঞ্জস্য জানায়; মেঝেতে খালি জায়গা চিহ্নিত করে না।";
"faq.freeFloorLocation" = "Placement Intelligence কি মেঝেতে খালি জায়গা খুঁজে দেয়?";
"faq.freeFloorLocationAnswer" = "না। এটি আনুমানিক ফার্নিচার মাত্রা রুমের পরিসরের সঙ্গে সামঞ্জস্যপূর্ণ কি না দেখে। এটি খালি মেঝে শনাক্ত বা নির্দিষ্ট খোলা স্থান চিহ্নিত করে না।";
"faq.dimensionalFit" = "মাত্রাগত ফিট কীভাবে গণনা করা হয়?";
"faq.dimensionalFitAnswer" = "আইটেমের আনুমানিক প্রস্থ, উচ্চতা ও নির্ণীত গভীরতা রুমের আনুমানিক মাত্রার সঙ্গে তুলনা করা হয়; প্রয়োজনে ঘোরানো ভিত্তিও বিবেচিত হয়। দুই সেট মাত্রাই আনুমানিক, তাই ফলাফল নির্দেশনা হিসেবে নিন।";
"faq.roomFitment" = "ফার্নিচার ফিট হবে কি না কীভাবে যাচাই করব?";
"faq.roomFitmentAnswer" = "সেগমেন্টেশনের পর মাপা ফার্নিচারের প্রস্থ ও উচ্চতার জন্য AR সাইজিং চালু করুন। Placement Intelligence এসব মান ও নির্ণীত গভীরতা রুমের পরিসরের সঙ্গে তুলনা করে। এটি নিশ্চিত খালি মেঝের স্থান চিহ্নিত করে না।";
"faq.aestheticGuidance" = "নান্দনিক নির্দেশনা";
"faq.aestheticScore" = "নান্দনিক স্কোর কীভাবে গণনা করা হয়?";
"faq.aestheticScoreAnswer" = "অ্যাপটি সেগমেন্ট করা ফার্নিচারের গড় দৃশ্যমান রং রুম থেকে নেওয়া রঙের সঙ্গে তুলনা করে। সুর, উজ্জ্বলতার কনট্রাস্ট ও সামগ্রিক স্টাইল সামঞ্জস্য স্কোরে অবদান রাখে। এগুলো আনুমানিক ডিজাইন নির্দেশক, রুচির নিয়ম নয়।";
"faq.furnitureColorAesthetic" = "নান্দনিক স্কোরের জন্য অ্যাপ কীভাবে রং বেছে নেয়?";
"faq.furnitureColorAestheticAnswer" = "অ্যাপটি AI ফার্নিচার কাটআউটের ভেতরের দৃশ্যমান পিক্সেলের সরাসরি RGB রঙের গড় নিয়ে রুম থেকে নমুনা করা রঙের সঙ্গে তুলনা করে। কোনো একটি নমুনা না থাকলে স্কোর বানিয়ে না দেখিয়ে নান্দনিক নির্দেশনা অনুপলভ্য থাকে।";
"faq.whatDoHarmonyContrastMean" = "হারমনি, কনট্রাস্ট ও স্টাইল ফিটের মানে কী?";
"faq.whatDoHarmonyContrastMeanAnswer" = "এগুলো সহজ ডিজাইন নির্দেশক, রুচির বিচার নয়। হারমনি বোঝায় ফার্নিচারের রং রুমের প্যালেটের সঙ্গে কীভাবে সম্পর্কিত, যেমন সদৃশ বা পরিপূরক রং। কনট্রাস্ট হলো সাধারণ মেঝে বা দেয়ালের উজ্জ্বলতার পার্থক্য। স্টাইল ফিট রুমের সাধারণ স্টাইল লেবেলকে ডিফল্ট আধুনিক প্রোফাইলের সঙ্গে তুলনা করে, তাই এটি আনুমানিক।";
"faq.aestheticUnavailable" = "নান্দনিক নির্দেশনা কেন অনুপলভ্য?";
"faq.aestheticUnavailableAnswer" = "নান্দনিক নির্দেশনার জন্য রুম ও সেগমেন্ট করা ফার্নিচার—দুটিরই ব্যবহারযোগ্য রঙের নমুনা দরকার। কোনো নমুনা না থাকলে Paafekt কৃত্রিম স্কোর দেখায় না।";
"faq.whenDoesAestheticScoreLow" = "নান্দনিক স্কোর কখন কম বা \"clash\" দেখাতে পারে?";
"faq.whenDoesAestheticScoreLowAnswer" = "উজ্জ্বল, অত্যন্ত স্যাচুরেটেড বস্তু রুমের সঙ্গে অ্যাপের সুরেলা রঙের নিয়মে না মিললে প্রায়ই কম স্কোর পায়। মেঝে বা দেয়ালের খুব কাছাকাছি উজ্জ্বলতাও কনট্রাস্ট কমাতে পারে। স্কোরকে শুধু নির্দেশনা হিসেবে নিন এবং বাস্তব সাজসজ্জায় নিজের চোখকে বিশ্বাস করুন।";
"faq.measurementsAccuracy" = "মাপ ও নির্ভুলতা";
"faq.accuracy" = "রুম ও ফার্নিচারের মাপ কতটা নির্ভুল?";
"faq.accuracyAnswer" = "মাপগুলো ডিভাইসে করা অনুমান এবং ছবির মান, আলো, ক্যামেরার কোণ ও AR ট্র্যাকিং অনুযায়ী বদলাতে পারে। এগুলো নির্দেশনা হিসেবে ব্যবহার করুন এবং সিদ্ধান্তের আগে গুরুত্বপূর্ণ মাত্রা নিজে যাচাই করুন।";
"faq.adjustDimensions" = "আমি কি রুমের মাত্রা বদলাতে পারি?";
"faq.adjustDimensionsAnswer" = "AI রুমের মাত্রা ম্যানুয়ালি সম্পাদনা করা যায় না। সেভ করার পর নিয়ন্ত্রণ আনুন এবং আনুমানিক প্রস্থ, উচ্চতা ও গভীরতা দেখতে রুলার ট্যাপ করুন। সেভের আগের প্রিভিউতে মাত্রা লুকানো থাকে—আগে সেভ করে আবার খুলুন। ম্যানুয়াল রুম আপনার আঁকা সীমানা অনুসরণ করে।";
"faq.purchaseReliance" = "ফার্নিচার কেনার সময় কি Paafekt-এর ওপর নির্ভর করতে পারি?";
"faq.purchaseRelianceAnswer" = "Paafekt-কে নির্দেশনা হিসেবে ব্যবহার করুন, নিশ্চয়তা হিসেবে নয়। কেনার আগে বিক্রেতার সঙ্গে মাত্রা, ফাঁকা জায়গা ও উপযোগিতা নিশ্চিত করুন।";
"faq.savedRoomsStorage" = "সেভ করা রুম ও স্টোরেজ";
"faq.howToSaveRoom" = "আমি কীভাবে একটি রুম সেভ করব?";
"faq.howToSaveRoomAnswer" = "3D রুম তৈরির পর নিয়ন্ত্রণ আনতে রুমে ট্যাপ করুন, তারপর সেভ আইকন (ডাউনলোড তীর) ট্যাপ করে নাম লিখুন। সেভ না করে প্রিভিউ ছাড়লে রুমটি বাতিল হয়ে যায়।";
