// FAQ - Ten categories
"faq.roomCreation" = "البدء";
"faq.howToCreate" = "كيف أنشئ غرفة؟";
"faq.howToCreateAnswer" = "اضغط على إنشاء غرفة، ثم التقط صورة أو اخترها. اختر AI Room للحصول على تقدير تلقائي أو الإعداد اليدوي لتحديد الغرفة بنفسك. احفظ الغرفة المكتملة لإضافتها إلى مكتبة الغرف.";
"faq.howToTakePhoto" = "كيف ألتقط صورة لإنشاء غرفة؟";
"faq.howToTakePhotoAnswer" = "عند إنشاء غرفة، اختر التقاط صورة. يمكنك اختيار قياسي (1x) أو زاوية واسعة (0.5× فائقة الاتساع). ثبّت جهازك واضغط على زر الالتقاط. تُستخدم الصورة بعد ذلك لإنشاء غرفتك ثلاثية الأبعاد.";
"faq.bestPhotos" = "ما نوع الصور الذي يحقق أفضل النتائج؟";
"faq.bestPhotosAnswer" = "لأفضل النتائج، التقط الصور في إضاءة جيدة مع إبقاء الكاميرا أفقية. حاول تصوير الغرفة كاملةً، بما فيها الأرضية والجدران وحواف السقف. تجنب الصور الضبابية أو المظلمة.";
"faq.howManyRooms" = "كم غرفة يمكنني إنشاؤها؟";
"faq.howManyRoomsAnswer" = "يمكنك حفظ ما يصل إلى 20 غرفة. احذف الغرف التي لم تعد بحاجة إليها لإخلاء مساحة. تعرض مكتبة الغرف العدد الحالي للغرف وإجمالي مساحة التخزين المستخدمة.";
"faq.howToView" = "كيف أعرض غرفتي ثلاثية الأبعاد؟";
"faq.howToViewAnswer" = "اضغط على أي غرفة في الشاشة الرئيسية لفتح العارض ثلاثي الأبعاد. اسحب للنظر حولك واقرص للتكبير. اضغط على الغرفة لإظهار عناصر تحكم إضافية (إعادة التمركز والمسطرة وCapture). يظل زر Fit الذهبي ظاهراً أسفل اليمين.";
"faq.howToNavigate" = "كيف أتنقل داخل الغرفة؟";
"faq.howToNavigateAnswer" = "اسحب على الغرفة لتدوير الكاميرا واقرص للتكبير. اضغط على الشاشة لإظهار شريط الأدوات، ثم اضغط على إعادة التمركز لاستعادة العرض الافتراضي. يعيد عنصر التحكم الصغير أسفل اليسار إظهار شريط الأدوات أيضاً عندما يكون مخفياً.";
"faq.aiRoomManualSetup" = "AI Room والإعداد اليدوي";
"faq.twoMethods" = "ما الفرق بين AI Room والإعداد اليدوي؟";
"faq.twoMethodsAnswer" = "يقدّر AI Room أبعاد الغرفة من صورة واحدة وينشئ تمثيلاً مقاساً ومكسواً بالملمس. وهو ليس إعادة بناء حجمية كاملة. يتيح لك الإعداد اليدوي تحديد حدود الغرفة بنفسك للحصول على تمثيل يمكن التحكم فيه بدرجة أكبر.";
"faq.whatIsAIRoom" = "ما الغرفة ثلاثية الأبعاد المدعومة بالذكاء الاصطناعي؟";
"faq.whatIsAIRoomAnswer" = "يستخدم AI Room تقدير العمق على الجهاز ومراسي الأثاث ومعايرة الكاميرا لتقدير غرفة مقاسة ومكسوة بالملمس من صورة واحدة. وهو ليس إعادة بناء حجمية كاملة.";
"faq.whatIsManualRoom" = "ما الإعداد اليدوي؟";
"faq.whatIsManualRoomAnswer" = "يتيح لك الإعداد اليدوي تحديد حدود الغرفة مباشرةً على الصورة للتحكم بدرجة أكبر في التمثيل الناتج.";
"faq.whichMethodBetter" = "أي طريقة أختار؟";
"faq.whichMethodBetterAnswer" = "اختر AI Room للحصول على تقدير تلقائي أسرع. اختر الإعداد اليدوي عندما تريد التحكم المباشر في حدود الغرفة. إذا لم تناسبك نتيجة إحدى الطريقتين، فجرّب الأخرى.";
"faq.depthAwareRoomPhoto" = "هل يساعد التقاط صورة داخل التطبيق في تحسين جودة الغرفة؟";
"faq.depthAwareRoomPhotoAnswer" = "نعم. على الأجهزة المدعومة، يؤدي اختيار التقاط صورة بدلاً من اختيارها من المعرض إلى استخدام كاميرا التطبيق مع العمق عند توفره، ما قد يحسن بناء غرفتك ثلاثية الأبعاد وضبط مقياسها.";
"faq.aiFeatures" = "اكتشاف الأثاث وتحديد حجمه";
"faq.whatIsBrainIcon" = "ماذا يفعل زر Fit؟";
"faq.whatIsBrainIconAnswer" = "اضغط على Fit لاكتشاف قطعة أثاث وإنشاء قصاصة شفافة فوق غرفتك ثلاثية الأبعاد. اسحب القصاصة لوضعها واقرص لتغيير حجمها. يوفر Fit معاينة بصرية؛ ويتطلب إرشاد الأبعاد المقاسة تحديد الحجم بمساعدة AR.";
"faq.whatIsViewfinderButton" = "ماذا يفعل وضع الفيديو الكامل في عارض الغرفة؟";
"faq.whatIsViewfinderButtonAnswer" = "أثناء تفعيل Fit، أظهر عناصر التحكم واضغط على رمز محدد المنظر لتبديل وضع الفيديو الكامل. سيظهر بث مباشر للكاميرا مع مربعات اكتشاف—اضغط على عنصر واحد أو أكثر، ثم اضغط على Segment. تختفي الكاميرا وتُركّب القصاصات الشفافة فوق غرفتك ثلاثية الأبعاد. اضغط على تم أعلى اليمين للخروج من وضع التجزئة أو من Fit بالكامل.";
"faq.whatIsSegmentation" = "ما تجزئة الأثاث؟";
"faq.whatIsSegmentationAnswer" = "تكتشف تجزئة الأثاث عنصراً في عرض الكاميرا وتفصل بكسلاته الظاهرة عن الخلفية ليظهر كقصاصة قابلة للتحريك. تتم المعالجة على هذا الجهاز.";
"faq.howToSegment" = "كيف أجزّئ الأثاث في عارض الغرفة؟";
"faq.howToSegmentAnswer" = "اضغط على Fit في عارض الغرفة. لإجراء فحص سريع، تُجزّأ القطعة الرئيسية تلقائياً. لاختيار قطع محددة: أظهر عناصر التحكم، وفعّل وضع الفيديو الكامل، ووجّه الكاميرا نحو الأثاث، واضغط على مربعات الاكتشاف، ثم اضغط على Segment. اضغط على تم أعلى اليمين للخروج.";
"faq.arAssistedSizing" = "ما تحديد الحجم بمساعدة AR؟";
"faq.arAssistedSizingAnswer" = "يقدّر تحديد الحجم بمساعدة AR أبعاد قطعة الأثاث باستخدام إمكانات الكاميرا والعمق المدعومة. تعتمد النتائج على جودة الالتقاط وظروف التتبع وتظل تقديرية.";
"faq.measurementPill" = "ما قراءة القياس الصغيرة؟";
"faq.measurementPillAnswer" = "تظهر شارة حجم الأثاث فقط عند تشغيل وضع تحديد الحجم ووجود تقدير حي صالح للارتفاع. يعرض زر المسطرة عرض الغرفة وارتفاعها وعمقها الحالي في بطاقة صغيرة. تكون هذه القراءات أقل موثوقية على الهواتف غير الداعمة لـ AR، ولا سيما للأثاث.";
"faq.resetOverlayScale" = "يبدو قناع الأثاث مكبّراً بشكل خاطئ—ماذا أفعل؟";
"faq.resetOverlayScaleAnswer" = "لم تعد هناك قائمة تجاوز. إذا بدت الطبقة غير صحيحة، فاضغط على تم للخروج من Fit ثم اضغط على Fit مجدداً، أو اقرص الأثاث يدوياً لضبط حجمه بدقة.";
"faq.pinchOverlaySize" = "ماذا يحدث عند قرص الأثاث المجزأ؟";
"faq.pinchOverlaySizeAnswer" = "يجعل القرص طبقة الأثاث أكبر أو أصغر. إذا كان وضع تحديد الحجم مفعّلاً وكانت شارة Furni ظاهرة، تتحدث الشارة إلى التقدير الحالي لحجم الأثاث بعد تغييره بالنسبة إلى الغرفة. وإذا كان الوضع متوقفاً، فلا يغيّر القرص سوى مظهر الطبقة على الشاشة.";
"faq.howToPlace" = "كيف أضع الأثاث في غرفتي؟";
"faq.howToPlaceAnswer" = "بعد الضغط على Segment، يظهر الأثاث المحدد كطبقة فوق الغرفة. اسحبه لتحديد موضعه واقرص لتغيير حجمه.";
"faq.multiplePieces" = "هل يمكنني إضافة عدة قطع أثاث؟";
"faq.multiplePiecesAnswer" = "في وضع الفيديو الكامل، حدد عدة مربعات اكتشاف واضغط على Segment لإنشاء قصاصاتها معاً. ويمكنك أيضاً تجزئة عنصر واحد في كل مرة باستخدام مسار Fit الافتراضي.";
"faq.placementIntelligence" = "Placement Intelligence";
"faq.whatIsPlacementIntelligence" = "ما Placement Intelligence؟";
"faq.whatIsPlacementIntelligenceAnswer" = "تقارن Placement Intelligence العرض والارتفاع والعمق المشتق المقدّرة للعنصر بغلاف الغرفة. ولا تعرض سوى التوافق البُعدي ولا تحدد موقعاً خالياً على الأرضية.";
"faq.freeFloorLocation" = "هل تعثر Placement Intelligence على موقع متاح على الأرضية؟";
"faq.freeFloorLocationAnswer" = "لا. فهي تتحقق من توافق أبعاد الأثاث المقدّرة مع غلاف الغرفة، ولا تكتشف مساحة أرضية خالية أو تحدد موقعاً مفتوحاً بعينه.";
"faq.dimensionalFit" = "كيف تُحسب الملاءمة البُعدية؟";
"faq.dimensionalFitAnswer" = "تُقارن قيم العرض والارتفاع والعمق المشتق المقدّرة للعنصر بأبعاد الغرفة المقدّرة، مع احتساب تدوير المساحة المشغولة عند الحاجة. ولأن مجموعتي الأبعاد تقديريتان، تعامل مع النتيجة على أنها إرشاد.";
"faq.roomFitment" = "كيف أتحقق من ملاءمة الأثاث؟";
"faq.roomFitmentAnswer" = "بعد التجزئة، فعّل تحديد الحجم باستخدام AR للحصول على عرض الأثاث وارتفاعه المقاسين. تقارن Placement Intelligence هاتين القيمتين والعمق المشتق بغلاف الغرفة. ولا تحدد موقعاً خالياً مضموناً على الأرضية.";
"faq.aestheticGuidance" = "الإرشاد الجمالي";
"faq.aestheticScore" = "كيف تُحسب الدرجة الجمالية؟";
"faq.aestheticScoreAnswer" = "يقارن التطبيق متوسط اللون المرئي للأثاث المجزأ بالألوان المأخوذة من الغرفة. ويسهم تناغم الألوان وتباين السطوع والتوافق العام للأسلوب في الدرجة. هذه مؤشرات تصميم تقريبية وليست قواعد للذوق.";
"faq.furnitureColorAesthetic" = "كيف يختار التطبيق لوناً للتقييم الجمالي؟";
"faq.furnitureColorAestheticAnswer" = "يحسب التطبيق متوسط لون RGB المباشر للبكسلات الظاهرة داخل قصاصة الأثاث المنشأة بالذكاء الاصطناعي ويقارنه بالألوان المأخوذة من الغرفة. إذا لم تتوفر إحدى العينتين، يظل الإرشاد الجمالي غير متاح بدلاً من اختلاق درجة.";
"faq.whatDoHarmonyContrastMean" = "ماذا تعني الملاءمة من حيث التناغم والتباين والأسلوب؟";
"faq.whatDoHarmonyContrastMeanAnswer" = "هذه مؤشرات تصميم بسيطة وليست حكماً على الذوق. يصف التناغم علاقة لون الأثاث بلوحة الغرفة، مثل الألوان المتجاورة أو المتكاملة. والتباين هو اختلاف السطوع عن ألوان الأرضية أو الجدران المعتادة. وتقارن ملاءمة الأسلوب تصنيفات عامة مستنتجة للغرفة بملف عصري افتراضي، لذا فهي تقريبية.";
"faq.aestheticUnavailable" = "لماذا لا يتوفر الإرشاد الجمالي؟";
"faq.aestheticUnavailableAnswer" = "يتطلب الإرشاد الجمالي عينات ألوان صالحة من الغرفة والأثاث المجزأ معاً. إذا لم تتوفر إحدى العينتين، لا يعرض Paafekt درجة بدلاً من اختلاقها.";
"faq.whenDoesAestheticScoreLow" = "متى قد تكون الدرجات الجمالية منخفضة أو تظهر كلمة \"تعارض\"؟";
"faq.whenDoesAestheticScoreLowAnswer" = "غالباً ما تحصل العناصر الزاهية والمشبعة على درجة أقل عندما لا يتوافق لونها مع مخططات الألوان المتناغمة للتطبيق في غرفتك، مثل الأخضر الحمضي أو الأرجواني أو البنفسجي أو البرتقالي الفاقع مع غرف دافئة بلون البيج أو الأسمر. وقد يقلل تشابه السطوع الشديد مع الأرضية أو الجدار التباين حتى إن أعجبك المظهر. تعامل مع الدرجات كإرشاد فقط وثق بعينك في الديكور الحقيقي.";
"faq.measurementsAccuracy" = "القياسات والدقة";
"faq.accuracy" = "ما مدى دقة قياسات الغرفة والأثاث؟";
"faq.accuracyAnswer" = "القياسات تقديرات تُجرى على الجهاز وقد تختلف باختلاف جودة الصورة والإضاءة وزاوية الكاميرا وتتبع AR. استخدمها كإرشاد وتحقق بنفسك من الأبعاد المهمة قبل اتخاذ القرارات.";
"faq.adjustDimensions" = "هل يمكنني تعديل أبعاد الغرفة؟";
"faq.adjustDimensionsAnswer" = "لا يمكنك تعديل أبعاد غرفة AI يدوياً. بعد الحفظ، أظهر عناصر التحكم واضغط على المسطرة لرؤية العرض والارتفاع والعمق المقدّرة. تكون شرائح الأبعاد مخفية في معاينة ما قبل الحفظ—احفظ الغرفة أولاً ثم افتحها مجدداً لرؤية القياسات. تتبع الغرف اليدوية الحدود التي ترسمها.";
"faq.purchaseReliance" = "هل يمكنني الاعتماد على Paafekt عند شراء الأثاث؟";
"faq.purchaseRelianceAnswer" = "استخدم Paafekt كدليل لا كضمان. تحقق دائماً من الأبعاد ومسافات الخلو والملاءمة مع البائع قبل الشراء.";
"faq.savedRoomsStorage" = "الغرف المحفوظة والتخزين";
"faq.howToSaveRoom" = "كيف أحفظ غرفة؟";
"faq.howToSaveRoomAnswer" = "بعد إنشاء غرفة ثلاثية الأبعاد، اضغط عليها لإظهار عناصر التحكم، ثم اضغط على رمز الحفظ (سهم التنزيل) وأدخل اسماً. إذا غادرت المعاينة دون حفظ، فسيتم التخلص من الغرفة.";
"faq.whereRoomsSaved" = "أين تُحفظ غرفي؟";
"faq.whereRoomsSavedAnswer" = "تُخزّن الغرف في مساحة التخزين الخاصة بتطبيق Paafekt على هذا الجهاز ولا تُرفع تلقائياً. الموقع الداخلي: Documents/SavedRooms.";
"faq.uninstallRooms" = "ماذا يحدث لغرفي إذا أزلت تثبيت Paafekt؟";
"faq.uninstallRoomsAnswer" = "تؤدي إزالة تثبيت Paafekt إلى حذف الغرف المخزنة في مساحة التطبيق الخاصة نهائياً. شارك كل ما تريد الاحتفاظ به قبل إزالة التثبيت.";
"faq.whatIsMemoryDisplay" = "ماذا يعني رقم MB؟";
"faq.whatIsMemoryDisplayAnswer" = "يشير رقم MB (ميجابايت) الظاهر في الغرف إلى حجم الملف، ما يساعدك على إدارة التخزين. يظهر إجمالي مساحة التخزين التي تستخدمها جميع الغرف أعلى الشاشة الرئيسية.";
"faq.sharingExporting" = "المشاركة والتصدير";
"faq.exportRoom" = "كيف أنشئ نسخة احتياطية من غرفة أو أصدّرها؟";
"faq.exportRoomAnswer" = "استخدم Share عندما يكون متاحاً لنوع الغرفة. تشارك Capture صورة للعرض الحالي وليست نسخة احتياطية قابلة للاستعادة. لا يوفر Paafekt حالياً مزامنة سحابية أو نسخة احتياطية مضمونة للمكتبة كاملةً.";
"faq.howToScreenshot" = "كيف ألتقط لقطة شاشة؟";
"faq.howToScreenshotAnswer" = "اضغط على الغرفة لإظهار عناصر التحكم، ثم اضغط على Capture. يؤدي ذلك إلى حفظ العرض الحالي، بما فيه طبقات الأثاث عند تشغيل Fit، في مكتبة الصور.";
"faq.privacyAccount" = "الخصوصية والحساب";
"faq.arePhotosUploaded" = "هل تُرفع صور غرفي؟";
"faq.arePhotosUploadedAnswer" = "لا. يتم إنشاء الغرف واكتشاف الأثاث وتشغيل Placement Intelligence على هذا الجهاز. وتعالج Firebase بشكل منفصل بيانات مصادقة رقم الهاتف ومنع إساءة الاستخدام. لا يغادر المحتوى Paafekt إلا عندما تشاركه صراحةً.";
"faq.firebaseData" = "ما البيانات التي تعالجها Firebase؟";
"faq.firebaseDataAnswer" = "تعالج Firebase رقم هاتفك وسجلات المصادقة ومعرّف تثبيت الجهاز المستخدم للتحقق ومنع إساءة الاستخدام. يظل إنشاء الغرف ومعالجة الأثاث على هذا الجهاز.";
"faq.deleteAccountEffect" = "ماذا يحدث عند حذف حسابي؟";
"faq.deleteAccountEffectAnswer" = "يؤدي حذف حسابك إلى إزالة حساب مصادقة Firebase وتسجيل خروجك. لا تُحذف الغرف المحفوظة على هذا الجهاز تلقائياً؛ احذفها في Paafekt أو أزل تثبيت التطبيق لإزالتها.";
"faq.troubleshootingSupport" = "استكشاف الأخطاء والدعم";
"faq.generationFailing" = "لماذا يفشل إنشاء غرفتي؟";
"faq.generationFailingAnswer" = "قد يفشل إنشاء الغرفة إذا كانت الصورة مظلمة جداً أو ضبابية أو لا تُظهر ما يكفي من معالم الغرفة. حاول التقاط صورة جديدة بإضاءة أفضل وزاوية أوسع.";
"faq.notDetected" = "لماذا لا يُكتشف أثاثي؟";
"faq.notDetectedAnswer" = "يعمل اكتشاف العناصر بأفضل صورة في بيئة واضحة وجيدة الإضاءة يكون فيها الأثاث ظاهراً بوضوح. تأكد من أن العنصر غير محجوب جزئياً أو بعيد جداً عن الكاميرا.";
"faq.whatDoArrowsDo" = "كيف أُظهر عناصر تحكم العارض أو أخفيها؟";
"faq.whatDoArrowsDoAnswer" = "يستخدم عارض الغرفة وضعاً غامراً، فتختفي عناصر التحكم للحصول على عرض نظيف. اضغط على الغرفة لإظهار شريط الأدوات. يظل زر Fit الذهبي أسفل اليمين ظاهراً دائماً. أثناء تشغيل Fit، يظهر زر تم أعلى اليمين للخروج من التجزئة.";
"faq.contactSupport" = "كيف أتواصل مع الدعم؟";
"faq.contactSupportAnswer" = "افتح الإعدادات ← المساعدة والدعم، ثم أرسل بريداً إلكترونياً إلى support@paafekt.com.";

