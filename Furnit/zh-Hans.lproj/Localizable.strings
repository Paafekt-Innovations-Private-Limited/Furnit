// FAQ - Room Creation
"faq.roomCreation" = "入门指南";
"faq.howToCreate" = "如何创建房间？";
"faq.howToCreateAnswer" = "轻点 Create Room，然后拍摄或选择一张照片。选择 AI Room 可自动估算，选择 Manual Setup 可自行定义房间。保存完成的房间后，它会添加到您的房间库中。";
"faq.howToTakePhoto" = "如何拍照来创建房间？";
"faq.howToTakePhotoAnswer" = "创建房间时，选择 Take a Photo。您可以选择 Standard（1x）或 Wide Angle（0.5× 超广角）。保持设备稳定并轻点拍摄，应用随后会使用该照片构建 3D 房间。";
"faq.depthAwareRoomPhoto" = "用应用内相机拍照会更好吗？";
"faq.depthAwareRoomPhotoAnswer" = "会。在支持的设备上，创建房间时选择拍照而非从相册选取，可使用内置相机与深度信息（若设备提供），有助于构建与比例。";
"faq.twoMethods" = "AI Room 与 Manual Setup 有什么区别？";
"faq.twoMethodsAnswer" = "AI Room 会根据一张照片估算房间尺寸，并生成带测量信息和纹理的呈现效果；它并非完整的体积式重建。Manual Setup 让您自行定义房间边界，以便更直接地控制呈现结果。";
"faq.whatIsAIRoom" = "什么是 AI 驱动的 3D 房间？";
"faq.whatIsAIRoomAnswer" = "AI Room 使用设备端深度估算、家具锚点和相机校准，根据一张照片估算带测量信息和纹理的房间；它并非完整的体积式重建。";
"faq.whatIsManualRoom" = "什么是手动设置？";
"faq.whatIsManualRoomAnswer" = "Manual Setup 让您直接在照片上定义房间边界，从而更灵活地控制最终呈现效果。";
"faq.whichMethodBetter" = "我该选哪种方式？";
"faq.whichMethodBetterAnswer" = "若想快速获得自动估算结果，请选择 AI Room；若想直接控制房间边界，请选择 Manual Setup。如果一种方式的结果不理想，可以尝试另一种。";
"faq.bestPhotos" = "什么样的照片效果最好？";
"faq.bestPhotosAnswer" = "为获得最佳效果，请在光线充足的环境下拍摄，并保持相机水平。尽量拍摄整个房间，包括地板、墙壁和天花板边緣。避免模糊或昏暗的照片。";
"faq.generationFailing" = "为什么我的房间产生失败？";
"faq.generationFailingAnswer" = "如果照片太暗、模糊或没有显示足够的房间特征，房间产生可能会失败。请尝试在更好的光线下以更宽的角度拍摄新照片。";
"faq.howManyRooms" = "我可以建立多少个房间？";
"faq.howManyRoomsAnswer" = "您最多可以保存 20 个房间。删除不再需要的房间即可腾出空间。房间库会显示当前房间数量和已用存储总量。";
"faq.howToSaveRoom" = "如何保存房间？";
"faq.howToSaveRoomAnswer" = "生成 3D 房间后，轻点房间以调出控件，再轻点保存图标（向下箭头）并输入名称。如果未保存就离开预览，该房间将被丢弃。";
"faq.whereRoomsSaved" = "我的房间保存在哪里？";
"faq.whereRoomsSavedAnswer" = "房间保存在此设备上 Paafekt 的私有应用存储空间中，不会自动上传。内部位置：Documents/SavedRooms。";
"faq.arePhotosUploaded" = "我的房间照片会上传吗？";
"faq.arePhotosUploadedAnswer" = "不会。房间创建、家具检测和 Placement Intelligence 均在此设备上运行。Firebase 会另外处理手机号码身份验证和防滥用数据。只有在您明确分享时，内容才会离开 Paafekt。";

// FAQ - Furniture Segmentation
"faq.whatIsSegmentation" = "什么是家具分割？";
"faq.whatIsSegmentationAnswer" = "家具分割会检测相机画面中的物品，并将其可见像素与背景分离，使其能以可移动抠图的形式显示。处理过程在此设备上运行。";
"faq.howToSegment" = "如何在房间查看器中分割家具？";
"faq.howToSegmentAnswer" = "在房间查看器中轻点 Fit。快速检查时，它会自动分割主要物品。若要选择特定家具，请调出控件、启用全视频模式、将相机对准家具、轻点检测框，然后轻点 Segment。轻点右上角的 Done 即可退出。";
"faq.notDetected" = "为什么我的家具没有被侦测到？";
"faq.notDetectedAnswer" = "家具侦测在清晰、光线充足且家具明显可见的照片中效果最佳。确保家具没有被部分遮挡或与背景融合。";
"faq.multiplePieces" = "我可以分割多件家具嗎？";
"faq.multiplePiecesAnswer" = "在全视频模式下，选择多个检测框并轻点 Segment，即可同时创建这些物品的抠图。您也可以通过默认的 Fit 流程逐件分割。";

// FAQ - 3D Room & Fitment
"faq.roomFitment" = "如何查看家具是否合适？";
"faq.roomFitmentAnswer" = "分割后，启用 AR 尺寸测量以获取家具的宽度和高度。Placement Intelligence 会将这些值和推导深度与房间范围进行比较，但不会指出保证可用的地板位置。";

// FAQ - Placement intelligence & aesthetic
"faq.placementIntelligence" = "Placement Intelligence";
"faq.whatIsPlacementIntelligence" = "什么是「摆放智能」（Placement Intelligence）？";
"faq.whatIsPlacementIntelligenceAnswer" = "Placement Intelligence 会将物品的估算宽度、高度和推导深度与房间范围进行比较。它只报告尺寸兼容性，不会识别地板上的空闲位置。";
"faq.furnitureColorAesthetic" = "美学评分用的颜色是怎么来的？";
"faq.furnitureColorAestheticAnswer" = "应用会计算 AI 家具抠图中可见像素的直接 RGB 平均色，并与从房间中采样的颜色进行比较。如果任一颜色样本不可用，美学指导会保持不可用，而不会凭空生成评分。";
"faq.whatDoHarmonyContrastMean" = "和谐度、对比度、风格匹配是什么意思？";
"faq.whatDoHarmonyContrastMeanAnswer" = "它们只是简单的设计启发规则，不是品味评判。和谐度描述家具颜色与房间主色之间的关系（例如类似色或互补色）。对比度衡量与典型地面、墙面亮度的差异。风格匹配把从房间推断的宽泛风格标签与默认的「现代/简约」档案对比，因此仅供参考。";
"faq.whenDoesAestheticScoreLow" = "什么情况下美学分数会偏低或显示「冲突（clash）」？";
"faq.whenDoesAestheticScoreLowAnswer" = "高饱和物体若色相与应用内的和谐配色规则、以及你房间采样色不协调，分数往往更低——例如酸绿、品红、紫色、安全橙放在偏米色、暖棕调房间里，或空间采样几乎单色时仍用刺眼原色。与地板或墙面亮度非常接近（棕上棕、灰上灰）也可能拉低对比度，即便你主观上喜欢。若房间被推断为乡村风、传统风，风格匹配可能偏低，因为家具档案默认带现代/简约标签。杂乱背景下得到的灰蒙蒙平均色有时会落在「中性」区间而非冲突。分数仅供提示，实际搭配请以肉眼为准。";
"faq.aiRoomManualSetup" = "AI Room 与 Manual Setup";
"faq.aestheticGuidance" = "美学指导";
"faq.measurementsAccuracy" = "测量与准确性";
"faq.savedRoomsStorage" = "已保存的房间与存储";
"faq.sharingExporting" = "分享与导出";
"faq.privacyAccount" = "隐私与账户";
"faq.troubleshootingSupport" = "故障排除与支持";
"faq.uninstallRooms" = "卸载 Paafekt 后，我的房间会怎样？";
"faq.uninstallRoomsAnswer" = "卸载 Paafekt 会永久移除保存在其私有应用存储空间中的房间。卸载前，请先分享您想保留的内容。";
"faq.exportRoom" = "如何备份或导出房间？";
"faq.exportRoomAnswer" = "当该房间类型支持 Share 时，可使用此功能。Capture 分享的是当前视图的图片，并不是可恢复的房间备份。Paafekt 目前不提供云同步，也不保证能够完整备份整个房间库。";
"faq.freeFloorLocation" = "Placement Intelligence 会在地板上查找可用位置吗？";
"faq.freeFloorLocationAnswer" = "不会。它只会检查家具的估算尺寸是否与房间范围兼容，不会检测空闲地面空间，也不会指出具体的空位。";
"faq.dimensionalFit" = "尺寸适配是如何计算的？";
"faq.dimensionalFitAnswer" = "应用会将物品的估算宽度、高度和推导深度与房间的估算尺寸进行比较，并在有帮助时考虑旋转后的占地范围。由于两组尺寸都是估算值，请仅将结果作为参考。";
"faq.aestheticScore" = "美学评分是如何计算的？";
"faq.aestheticScoreAnswer" = "应用会将已分割家具的平均可见颜色与从房间中采样的颜色进行比较。色彩和谐度、亮度对比度和整体风格兼容性都会影响评分。这些只是近似的设计启发规则，并非审美准则。";
"faq.aestheticUnavailable" = "为什么无法提供美学指导？";
"faq.aestheticUnavailableAnswer" = "美学指导需要房间和已分割家具双方都有可用的颜色样本。如果任一方的样本不可用，Paafekt 不会凭空生成评分。";
"faq.purchaseReliance" = "购买家具时可以依赖 Paafekt 吗？";
"faq.purchaseRelianceAnswer" = "请将 Paafekt 作为参考，而非保证。购买前务必向卖家确认尺寸、预留空间和适用性。";
"faq.deleteAccountEffect" = "删除账户后会怎样？";
"faq.deleteAccountEffectAnswer" = "删除账户会移除 Firebase 身份验证账户并退出登录。保存在此设备上的房间不会自动删除；请在 Paafekt 中删除，或卸载应用以将其移除。";
"faq.firebaseData" = "Firebase 会处理哪些数据？";
"faq.firebaseDataAnswer" = "Firebase 会处理您的手机号码、身份验证记录，以及用于验证和防止滥用的设备安装标识符。房间创建和家具处理仍在此设备上进行。";
"faq.contactSupport" = "如何联系支持团队？";
"faq.contactSupportAnswer" = "打开设置 → 帮助与支持，然后发送电子邮件至 support@paafekt.com。";

"faq.howToView" = "如何检视我的3D房间？";
"faq.howToViewAnswer" = "在主屏幕点击任意房间打开 3D 查看器。拖动环视，捏合缩放。点击房间可唤出更多控件（重新居中、尺子、Capture）。右下角金色 Fit 按钮始终可见。";
"faq.howToPlace" = "如何在房间中放置家具？";
"faq.howToPlaceAnswer" = "点击分割后，选中的家具会以叠层形式出现在房间里。拖动可定位，双指缩放可调整大小，旋转可调整方向。";
"faq.accuracy" = "房间和家具测量有多准确？";
"faq.accuracyAnswer" = "测量结果是在设备上生成的估算值，会受到照片质量、光线、相机角度和 AR 跟踪的影响。请将其作为参考，并在做决定前自行确认重要尺寸。";
"faq.adjustDimensions" = "我可以调整房间尺寸嗎？";
"faq.adjustDimensionsAnswer" = "AI Room 的尺寸无法手动编辑。保存后，调出控件并轻点尺子，即可查看估算的宽度、高度和深度。保存前的预览不会显示尺寸标签；请先保存房间，再重新打开以查看测量结果。手动房间会采用您绘制的边界。";
"faq.arAssistedSizing" = "什么是 AR 辅助尺寸测量？";
"faq.arAssistedSizingAnswer" = "AR 辅助尺寸测量会利用受支持的相机和深度感知能力估算家具尺寸。结果取决于拍摄质量和跟踪条件，仍属于估算值。";
"faq.measurementPill" = "画面上小小的测量提示是什么？";
"faq.measurementPillAnswer" = "只有在尺寸模式开启且应用获得可用的实时高度估算时，家具尺寸标签才会出现。尺子按钮会在小卡片中显示当前房间的宽度、高度和深度。在不支持 AR 的手机上，这些读数较不可靠，尤其是家具尺寸。";
"faq.resetOverlayScale" = "检测遮罩缩放看起来不对怎么办？";
"faq.resetOverlayScaleAnswer" = "现在没有更多选项菜单。如果叠加层显示异常，请轻点 Done 退出 Fit，再次轻点 Fit；也可以双指捏合家具，手动微调其大小。";

