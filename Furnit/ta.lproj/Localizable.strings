// FAQ - AI Features (added)
"faq.whatIsBrainIcon" = "What does the Fit button do?";
"faq.whatIsViewfinderButton" = "What does full-video mode do in the room viewer?";
"faq.whatIsViewfinderButtonAnswer" = "While Fit is active, summon controls and tap the viewfinder icon to toggle full-video mode. You get a live camera feed with detection boxes—tap one or more items, then tap Segment. The camera hides and transparent cutouts composite over your 3D room. Tap Done (top-right) to exit segment mode or leave Fit entirely.";
"faq.howToScreenshot" = "ஸ்கிரீன்ஷாட் எப்படி எடுப்பது?";
"faq.howToScreenshotAnswer" = "Tap the room to summon controls, then tap Capture. This saves the current view (including furniture overlays when Fit is on) to your Photos library.";
"faq.howToSaveRoom" = "அறையை எப்படி சேமிப்பது?";
"faq.howToSaveRoomAnswer" = "After generating a 3D room, tap the room to summon controls, then tap the save icon (download arrow) and enter a name. If you leave a preview without saving, that room is discarded.";

// FAQ - 3D Room Controls (added)
"faq.howToNavigate" = "அறைக்குள் எப்படி செல்வது?";
"faq.howToNavigateAnswer" = "Drag on the room to orbit the camera and pinch to zoom. Tap the screen to summon the toolbar, then use the viewfinder icon to recenter. A quiet summon disk at bottom-left also brings controls back when hidden.";
"faq.whatDoArrowsDo" = "How do I show or hide viewer controls?";
"faq.whatDoArrowsDoAnswer" = "The room viewer uses immersive mode—controls hide for a clean view. Tap the room to summon the toolbar. The gold Fit button at bottom-right is always visible. While Fit is active, Done appears top-right to exit segmentation.";
"faq.whatIsMemoryDisplay" = "MB எண் என்ன அர்த்தம்?";
"faq.whatIsMemoryDisplayAnswer" = "அறைகளில் காட்டப்படும் MB (மெகாபைட்கள்) கோப்பு அளவைக் குறிக்கிறது. இது சேமிப்பகத்தை நிர்வகிக்க உதவுகிறது. அனைத்து அறைகளும் பயன்படுத்தும் மொத்த சேமிப்பகம் முகப்புத் திரையின் மேலே காட்டப்படும்.";

